# ===========================================================================
# RURAL TECH - EXEMPLO DE CONFIGURAÇÃO
# ===========================================================================
# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.
# O arquivo .env NÃO deve ser enviado ao Git (já está no .gitignore).
# ===========================================================================

# --- Banco de dados ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rural_tech

# Número máximo de conexões simultâneas no pool (opcional).
DB_CONNECTION_LIMIT=10

# --- Servidor ---------------------------------------------------------------
PORT=3000

# "development" mostra detalhes técnicos na página de erro.
# Em produção use "production".
NODE_ENV=development

# --- Sessão -----------------------------------------------------------------
# Nome do cookie de sessão.
SESSION_COOKIE_NAME=ruraltech_sessao

# Validade da sessão em dias.
SESSION_MAX_AGE_DAYS=7

# Defina como "true" somente quando o site estiver em HTTPS.
COOKIE_SECURE=false
