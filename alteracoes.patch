+// ==========================================
+// GASTOS
+// ==========================================
+//   GET  /controle-de-gastos            -> tela com os gastos já registrados (resumo)
+//   GET  /controle-de-gastos/registrar  -> formulário para registrar um novo gasto
+//   POST /api/gastos                    -> salva o gasto no banco
+
+const express = require("express");
+const conexao = require("../config/db");
+const { paginaProtegida, apiProtegida } = require("../middleware/sessao");
+const { dataValida, hojeISO } = require("../utils/formatar");
+
+const router = express.Router();
+
+const CATEGORIAS = [
+    "Alimentação",
+    "Aluguel/Espaço",
+    "Equipamentos",
+    "Impostos/Taxas",
+    "Marketing/Anúncios",
+    "Serviços Terceirizados",
+    "Utilidades (Água/Luz/Internet)"
+];
+
+const FORMAS_PAGAMENTO = [
+    "Dinheiro",
+    "Pix",
+    "Cartão de Crédito",
+    "Cartão de Débito",
+    "Boleto Bancário",
+    "Transferência (TED/DOC)"
+];
+
+const CLASSIFICACOES = ["Produção", "Infraestrutura", "Transporte", "Outros"];
+
+// ------------------------------------------
+// TELA: gastos já registrados
+// ------------------------------------------
+router.get("/controle-de-gastos", paginaProtegida, async (req, res, next) => {
+    try {
+        const gastos = await conexao.consultar(`
+            SELECT
+                id_gasto,
+                descricao,
+                categoria,
+                classificacao,
+                forma_pagamento,
+                fornecedor,
+                valor,
+                data_gasto
+            FROM gastos
+            ORDER BY data_gasto DESC, id_gasto DESC
+        `);
+
+        const hoje = hojeISO();
+        const mesAtual = hoje.slice(0, 7); // "2026-10"
+
+        let totalGeral = 0;
+        let totalMes = 0;
+
+        gastos.forEach((gasto) => {
+            gasto.valor = Number(gasto.valor);
+
+            totalGeral += gasto.valor;
+
+            if (String(gasto.data_gasto).slice(0, 7) === mesAtual) {
+                totalMes += gasto.valor;
+            }
+        });
+
+        res.render("gastos_resumo", {
+            gastos,
+            totalRegistros: gastos.length,
+            totalGeral,
+            totalMes
+        });
+    } catch (erro) {
+        next(erro);
+    }
+});
+
+// ------------------------------------------
+// TELA: formulário de novo gasto
+// ------------------------------------------
+router.get("/controle-de-gastos/registrar", paginaProtegida, (req, res) => {
+    res.render("controle_de_gastos", {
+        categorias: CATEGORIAS,
+        formasPagamento: FORMAS_PAGAMENTO,
+        classificacoes: CLASSIFICACOES
+    });
+});
+
+// ------------------------------------------
+// SALVAR GASTO
+// ------------------------------------------
+router.post("/api/gastos", apiProtegida, async (req, res, next) => {
+    try {
+        const corpo = req.body || {};
+
+        const descricao = String(corpo.descricao || "").trim();
+        const valor = Number(corpo.valor);
+        const fornecedor = String(corpo.fornecedor || "").trim();
+        const observacao = String(corpo.observacao || "").trim();
+
+        if (descricao === "" || descricao.length > 255) {
+            return res.status(400).json({ erro: "Informe a descrição do gasto (até 255 caracteres)." });
+        }
+
+        if (!CATEGORIAS.includes(corpo.categoria)) {
+            return res.status(400).json({ erro: "Selecione a categoria." });
+        }
+
+        if (!dataValida(corpo.data_gasto)) {
+            return res.status(400).json({ erro: "Informe uma data válida." });
+        }
+
+        // valor máximo da coluna DECIMAL(10,2)
+        if (!(valor > 0) || valor >= 100000000) {
+            return res.status(400).json({ erro: "Informe um valor válido." });
+        }
+
+        if (!FORMAS_PAGAMENTO.includes(corpo.forma_pagamento)) {
+            return res.status(400).json({ erro: "Selecione a forma de pagamento." });
+        }
+
+        if (!CLASSIFICACOES.includes(corpo.classificacao)) {
+            return res.status(400).json({ erro: "Selecione a classificação do gasto." });
+        }
+
+        if (fornecedor.length > 150) {
+            return res.status(400).json({ erro: "O fornecedor deve ter até 150 caracteres." });
+        }
+
+        const resultado = await conexao.consultar(
+            `INSERT INTO gastos
+                (id_usuario, descricao, categoria, forma_pagamento,
+                 fornecedor, classificacao, observacao, valor, data_gasto)
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+            [
+                req.usuario.id_usuario,
+                descricao,
+                corpo.categoria,
+                corpo.forma_pagamento,
+                fornecedor || null,
+                corpo.classificacao,
+                observacao || null,
+                valor,
+                corpo.data_gasto
+            ]
+        );
+
+        res.status(201).json({ id_gasto: resultado.insertId });
+    } catch (erro) {
+        next(erro);
+    }
+});
+
+module.exports = router;
