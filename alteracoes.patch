+-- =====================================================================
+-- ATUALIZAÇÃO DO BANCO (para quem JÁ criou o banco rural_tech antes)
+-- Rode este arquivo UMA vez no MySQL. Quem criar o banco do zero com o
+-- banco.sql não precisa rodar este arquivo.
+-- =====================================================================
+
+USE rural_tech;
+
+-- Telefone do perfil (tela "Editar perfil")
+ALTER TABLE usuarios
+    ADD COLUMN telefone VARCHAR(20);
+
+-- Campos da tela "Registrar gastos"
+ALTER TABLE gastos
+    ADD COLUMN categoria VARCHAR(60) AFTER descricao,
+    ADD COLUMN forma_pagamento VARCHAR(40) AFTER categoria,
+    ADD COLUMN fornecedor VARCHAR(150) AFTER forma_pagamento,
+    ADD COLUMN classificacao VARCHAR(40) AFTER fornecedor,
+    ADD COLUMN observacao TEXT AFTER classificacao;
+
+-- Tabela da tela "Registrar perda"
+CREATE TABLE perdas (
+    id_perda INT AUTO_INCREMENT PRIMARY KEY,
+    id_usuario INT NOT NULL,
+    id_produto INT NOT NULL,
+    data_perda DATE NOT NULL,
+    quantidade DECIMAL(10,2) NOT NULL,
+    unidade VARCHAR(20) NOT NULL,
+    motivo VARCHAR(30) NOT NULL,
+    local_perda VARCHAR(150) NOT NULL,
+    valor_estimado DECIMAL(10,2) NOT NULL,
+    observacoes TEXT,
+
+    FOREIGN KEY (id_usuario)
+        REFERENCES usuarios(id_usuario),
+
+    FOREIGN KEY (id_produto)
+        REFERENCES produtos(id_produto)
+);
