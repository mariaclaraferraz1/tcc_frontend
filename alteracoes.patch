@@ -0,0 +1,174 @@
+// ==========================================
+// PERDAS
+// ==========================================
+//   GET  /perdas            -> tela com as perdas já registradas (resumo)
+//   GET  /perdas/registrar  -> formulário para registrar uma nova perda
+//   POST /api/perdas        -> salva a perda no banco
+
+const express = require("express");
+const conexao = require("../config/db");
+const { paginaProtegida, apiProtegida } = require("../middleware/sessao");
+const { dataValida } = require("../utils/formatar");
+
+const router = express.Router();
+
+const UNIDADES = ["kg", "sacas", "toneladas"];
+
+const MOTIVOS = {
+    pragas: "Pragas",
+    doencas: "Doenças",
+    clima: "Condições climáticas",
+    seca: "Seca",
+    chuva: "Excesso de chuva",
+    geada: "Geada",
+    armazenamento: "Problemas no armazenamento",
+    transporte: "Problemas no transporte",
+    outros: "Outros"
+};
+
+// ------------------------------------------
+// TELA: perdas já registradas
+// ------------------------------------------
+router.get("/perdas", paginaProtegida, async (req, res, next) => {
+    try {
+        const perdas = await conexao.consultar(`
+            SELECT
+                pe.id_perda,
+                p.nome AS produto,
+                pe.data_perda,
+                pe.quantidade,
+                pe.unidade,
+                pe.motivo,
+                pe.local_perda,
+                pe.valor_estimado
+            FROM perdas pe
+            INNER JOIN produtos p ON pe.id_produto = p.id_produto
+            ORDER BY pe.data_perda DESC, pe.id_perda DESC
+        `);
+
+        let valorTotal = 0;
+        const porMotivo = {};
+
+        perdas.forEach((perda) => {
+            perda.valor_estimado = Number(perda.valor_estimado);
+            perda.quantidade = Number(perda.quantidade);
+            perda.motivo_texto = MOTIVOS[perda.motivo] || perda.motivo;
+
+            valorTotal += perda.valor_estimado;
+
+            porMotivo[perda.motivo_texto] =
+                (porMotivo[perda.motivo_texto] || 0) + perda.valor_estimado;
+        });
+
+        // Motivo que mais custou
+        let motivoPrincipal = "-";
+        let maior = 0;
+
+        Object.keys(porMotivo).forEach((motivo) => {
+            if (porMotivo[motivo] > maior) {
+                maior = porMotivo[motivo];
+                motivoPrincipal = motivo;
+            }
+        });
+
+        res.render("perdas_resumo", {
+            perdas,
+            totalRegistros: perdas.length,
+            valorTotal,
+            motivoPrincipal
+        });
+    } catch (erro) {
+        next(erro);
+    }
+});
+
+// ------------------------------------------
+// TELA: formulário de nova perda
+// ------------------------------------------
+router.get("/perdas/registrar", paginaProtegida, async (req, res, next) => {
+    try {
+        const produtos = await conexao.consultar(
+            "SELECT id_produto, nome FROM produtos ORDER BY nome"
+        );
+
+        res.render("perdas", { produtos, motivos: MOTIVOS });
+    } catch (erro) {
+        next(erro);
+    }
+});
+
+// ------------------------------------------
+// SALVAR PERDA
+// ------------------------------------------
+router.post("/api/perdas", apiProtegida, async (req, res, next) => {
+    try {
+        const corpo = req.body || {};
+
+        const idProduto = Number(corpo.id_produto);
+        const quantidade = Number(corpo.quantidade);
+        const valor = Number(corpo.valor_estimado);
+        const local = String(corpo.local_perda || "").trim();
+        const observacoes = String(corpo.observacoes || "").trim();
+
+        if (!Number.isInteger(idProduto) || idProduto <= 0) {
+            return res.status(400).json({ erro: "Selecione o produto." });
+        }
+
+        if (!dataValida(corpo.data_perda)) {
+            return res.status(400).json({ erro: "Informe uma data válida." });
+        }
+
+        if (!(quantidade > 0)) {
+            return res.status(400).json({ erro: "Informe uma quantidade válida." });
+        }
+
+        if (!UNIDADES.includes(corpo.unidade)) {
+            return res.status(400).json({ erro: "Selecione a unidade." });
+        }
+
+        if (!MOTIVOS[corpo.motivo]) {
+            return res.status(400).json({ erro: "Selecione o motivo da perda." });
+        }
+
+        if (local === "" || local.length > 150) {
+            return res.status(400).json({ erro: "Informe o local da perda (até 150 caracteres)." });
+        }
+
+        if (!(valor >= 0)) {
+            return res.status(400).json({ erro: "Informe um valor estimado válido." });
+        }
+
+        const produto = await conexao.consultar(
+            "SELECT id_produto FROM produtos WHERE id_produto = ?",
+            [idProduto]
+        );
+
+        if (produto.length === 0) {
+            return res.status(400).json({ erro: "Produto não encontrado." });
+        }
+
+        const resultado = await conexao.consultar(
+            `INSERT INTO perdas
+                (id_usuario, id_produto, data_perda, quantidade, unidade,
+                 motivo, local_perda, valor_estimado, observacoes)
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+            [
+                req.usuario.id_usuario,
+                idProduto,
+                corpo.data_perda,
+                quantidade,
+                corpo.unidade,
+                corpo.motivo,
+                local,
+                valor,
+                observacoes || null
+            ]
+        );
+
+        res.status(201).json({ id_perda: resultado.insertId });
+    } catch (erro) {
+        next(erro);
+    }
+});
+
+module.exports = router;
diff --git a/src/routes/relatorios.js b/src/routes/relatorios.js
new file mode 100644
index 0000000..09b3d94
--- /dev/null
+++ b/src/routes/relatorios.js
@@ -0,0 +1,271 @@
+// ==========================================
+// RELATÓRIOS
+// ==========================================
+//   GET /relatorios                      -> tela de relatórios
+//   GET /relatorio/:tipo                 -> dados em JSON (tela)
+//   GET /relatorio/:tipo/pdf             -> arquivo PDF para baixar
+//
+// :tipo = producao | vendas | gastos | produtos
+// Filtros opcionais: ?dataInicial=AAAA-MM-DD&dataFinal=AAAA-MM-DD
+
+const express = require("express");
+const conexao = require("../config/db");
+const { paginaProtegida, apiProtegida } = require("../middleware/sessao");
+const {
+    formatarData,
+    formatarMoeda,
+    formatarNumero,
+    agoraTexto,
+    dataValida
+} = require("../utils/formatar");
+const { gerarPdfRelatorio } = require("../utils/pdf");
+
+const router = express.Router();
+
+// Cada relatório: consulta, colunas do PDF e totais
+const RELATORIOS = {
+    producao: {
+        titulo: "Relatório de Produção",
+        campoData: "pr.data_producao",
+        sql: `
+            SELECT
+                p.nome AS produto,
+                p.unidade AS unidade,
+                pr.quantidade,
+                pr.data_producao
+            FROM producao pr
+            INNER JOIN produtos p ON pr.id_produto = p.id_produto
+            {WHERE}
+            ORDER BY pr.data_producao DESC, pr.id_producao DESC
+        `,
+        colunas: [
+            { titulo: "Produto", largura: 0.42, alinhar: "esquerda" },
+            { titulo: "Quantidade", largura: 0.30, alinhar: "direita" },
+            { titulo: "Data", largura: 0.28, alinhar: "direita" }
+        ],
+        linha: (item) => [
+            item.produto,
+            formatarNumero(item.quantidade) + (item.unidade ? " " + item.unidade : ""),
+            formatarData(item.data_producao)
+        ],
+        resumo: (itens) => [`Total de registros: ${itens.length}`]
+    },
+
+    vendas: {
+        titulo: "Relatório de Vendas",
+        campoData: "v.data_venda",
+        sql: `
+            SELECT
+                p.nome AS produto,
+                v.quantidade,
+                v.valor_total,
+                v.data_venda
+            FROM vendas v
+            INNER JOIN produtos p ON v.id_produto = p.id_produto
+            {WHERE}
+            ORDER BY v.data_venda DESC, v.id_venda DESC
+        `,
+        colunas: [
+            { titulo: "Produto", largura: 0.34, alinhar: "esquerda" },
+            { titulo: "Quantidade", largura: 0.20, alinhar: "direita" },
+            { titulo: "Valor total", largura: 0.26, alinhar: "direita" },
+            { titulo: "Data", largura: 0.20, alinhar: "direita" }
+        ],
+        linha: (item) => [
+            item.produto,
+            formatarNumero(item.quantidade),
+            formatarMoeda(item.valor_total),
+            formatarData(item.data_venda)
+        ],
+        resumo: (itens) => [
+            `Total de registros: ${itens.length}`,
+            `Valor total vendido: ${formatarMoeda(somar(itens, "valor_total"))}`
+        ]
+    },
+
+    gastos: {
+        titulo: "Relatório de Gastos",
+        campoData: "data_gasto",
+        sql: `
+            SELECT
+                descricao,
+                categoria,
+                valor,
+                data_gasto
+            FROM gastos
+            {WHERE}
+            ORDER BY data_gasto DESC, id_gasto DESC
+        `,
+        colunas: [
+            { titulo: "Descrição", largura: 0.40, alinhar: "esquerda" },
+            { titulo: "Categoria", largura: 0.26, alinhar: "esquerda" },
+            { titulo: "Valor", largura: 0.18, alinhar: "direita" },
+            { titulo: "Data", largura: 0.16, alinhar: "direita" }
+        ],
+        linha: (item) => [
+            item.descricao,
+            item.categoria || "-",
+            formatarMoeda(item.valor),
+            formatarData(item.data_gasto)
+        ],
+        resumo: (itens) => [
+            `Total de registros: ${itens.length}`,
+            `Total gasto: ${formatarMoeda(somar(itens, "valor"))}`
+        ]
+    },
+
+    // A tabela de produtos não tem data, então o filtro de período não se aplica
+    produtos: {
+        titulo: "Relatório de Produtos",
+        campoData: null,
+        sql: `
+            SELECT
+                nome AS produto,
+                unidade,
+                preco,
+                estoque
+            FROM produtos
+            ORDER BY nome
+        `,
+        colunas: [
+            { titulo: "Produto", largura: 0.38, alinhar: "esquerda" },
+            { titulo: "Unidade", largura: 0.22, alinhar: "esquerda" },
+            { titulo: "Preço", largura: 0.20, alinhar: "direita" },
+            { titulo: "Estoque", largura: 0.20, alinhar: "direita" }
+        ],
+        linha: (item) => [
+            item.produto,
+            item.unidade || "-",
+            formatarMoeda(item.preco),
+            formatarNumero(item.estoque)
+        ],
+        resumo: (itens) => [`Total de produtos: ${itens.length}`]
+    }
+};
+
+function somar(itens, campo) {
+    return itens.reduce((total, item) => total + Number(item[campo] || 0), 0);
+}
+
+// Lê e valida os filtros de data. Devolve { erro } ou { inicio, fim }
+function lerPeriodo(query) {
+    const inicio = query.dataInicial || "";
+    const fim = query.dataFinal || "";
+
+    if (!inicio && !fim) {
+        return { inicio: "", fim: "" };
+    }
+
+    if (!inicio || !fim) {
+        return { erro: "Preencha a data inicial e a data final." };
+    }
+
+    if (!dataValida(inicio) || !dataValida(fim)) {
+        return { erro: "Data inválida." };
+    }
+
+    if (inicio > fim) {
+        return { erro: "A data inicial não pode ser maior que a data final." };
+    }
+
+    return { inicio, fim };
+}
+
+async function buscarDados(relatorio, periodo) {
+    let where = "";
+    const parametros = [];
+
+    if (relatorio.campoData && periodo.inicio) {
+        where = `WHERE ${relatorio.campoData} BETWEEN ? AND ?`;
+        parametros.push(periodo.inicio, periodo.fim);
+    }
+
+    const itens = await conexao.consultar(
+        relatorio.sql.replace("{WHERE}", where),
+        parametros
+    );
+
+    return itens;
+}
+
+// ------------------------------------------
+// TELA
+// ------------------------------------------
+router.get("/relatorios", paginaProtegida, (req, res) => {
+    res.render("relatorios");
+});
+
+// ------------------------------------------
+// DADOS (JSON) -- usado pela tela
+// ------------------------------------------
+router.get("/relatorio/:tipo", apiProtegida, async (req, res, next) => {
+    try {
+        const relatorio = RELATORIOS[req.params.tipo];
+
+        if (!relatorio) {
+            return res.status(404).json({ erro: "Tipo de relatório inválido." });
+        }
+
+        const periodo = lerPeriodo(req.query);
+
+        if (periodo.erro) {
+            return res.status(400).json({ erro: periodo.erro });
+        }
+
+        const itens = await buscarDados(relatorio, periodo);
+
+        res.json(itens);
+    } catch (erro) {
+        next(erro);
+    }
+});
+
+// ------------------------------------------
+// PDF
+// ------------------------------------------
+router.get("/relatorio/:tipo/pdf", apiProtegida, async (req, res, next) => {
+    try {
+        const relatorio = RELATORIOS[req.params.tipo];
+
+        if (!relatorio) {
+            return res.status(404).json({ erro: "Tipo de relatório inválido." });
+        }
+
+        const periodo = lerPeriodo(req.query);
+
+        if (periodo.erro) {
+            return res.status(400).json({ erro: periodo.erro });
+        }
+
+        const itens = await buscarDados(relatorio, periodo);
+
+        let subtitulo = "Todos os registros";
+
+        if (!relatorio.campoData) {
+            subtitulo = "Situação atual do cadastro";
+        } else if (periodo.inicio) {
+            subtitulo = `Período: ${formatarData(periodo.inicio)} a ${formatarData(periodo.fim)}`;
+        }
+
+        const pdf = gerarPdfRelatorio({
+            titulo: relatorio.titulo,
+            subtitulo,
+            colunas: relatorio.colunas,
+            linhas: itens.map(relatorio.linha),
+            resumo: relatorio.resumo(itens),
+            geradoEm: agoraTexto()
+        });
+
+        res.set({
+            "Content-Type": "application/pdf",
+            "Content-Length": pdf.length,
+            "Content-Disposition": `attachment; filename="relatorio-${req.params.tipo}.pdf"`
+        });
+
+        res.send(pdf);
+    } catch (erro) {
+        next(erro);
+    }
+});
+
+module.exports = router;
diff --git a/src/utils/formatar.js b/src/utils/formatar.js
new file mode 100644
