diff --git a/public/css/resumo.css b/public/css/resumo.css
new file mode 100644
index 0000000..ebef689
--- /dev/null
+++ b/public/css/resumo.css
@@ -0,0 +1,201 @@
+/* ==============================
+   TELAS DE RESUMO (perdas e gastos)
+============================== */
+
+.cabecalho-resumo {
+    margin-bottom: 22px;
+}
+
+.cabecalho-resumo h1 {
+    color: #2E2E2E;
+    font-size: 25px;
+    margin-bottom: 8px;
+}
+
+.cabecalho-resumo h1 i {
+    color: #5E8F66;
+    font-size: 20px;
+    margin-right: 8px;
+}
+
+.cabecalho-resumo p {
+    color: #777;
+    font-size: 14px;
+}
+
+
+/* CARDS DE TOTAIS */
+
+.cards-resumo {
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    gap: 14px;
+    margin-bottom: 22px;
+}
+
+.card-total {
+    background: white;
+    border-radius: 12px;
+    padding: 16px 18px;
+    box-shadow: 0 2px 6px rgba(0, 0, 0, .08);
+    border-left: 5px solid #5E8F66;
+}
+
+.card-total span {
+    display: block;
+    color: #777;
+    font-size: 12px;
+    margin-bottom: 6px;
+}
+
+.card-total strong {
+    display: block;
+    color: #315C3A;
+    font-size: 21px;
+    overflow-wrap: anywhere;
+}
+
+.card-total.alerta {
+    border-left-color: #C0504D;
+}
+
+.card-total.alerta strong {
+    color: #A63C39;
+}
+
+
+/* LISTA */
+
+.card-lista {
+    background: #DDE8D8;
+    border-radius: 12px;
+    padding: 22px;
+    box-shadow: 0 2px 6px rgba(0, 0, 0, .08);
+}
+
+.topo-lista {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    flex-wrap: wrap;
+    padding-bottom: 15px;
+    margin-bottom: 16px;
+    border-bottom: 1px solid #A9C2AE;
+}
+
+.topo-lista h2 {
+    color: #2E2E2E;
+    font-size: 19px;
+}
+
+.btn-novo {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    background: #5E8F66;
+    color: white;
+    text-decoration: none;
+    font-size: 14px;
+    font-weight: bold;
+    padding: 11px 18px;
+    border-radius: 8px;
+}
+
+.btn-novo:hover {
+    background: #4E7B56;
+}
+
+.tabela-rolagem {
+    overflow-x: auto;
+    background: white;
+    border-radius: 8px;
+}
+
+.tabela-resumo {
+    width: 100%;
+    border-collapse: collapse;
+    font-size: 13px;
+    min-width: 560px;
+}
+
+.tabela-resumo th {
+    text-align: left;
+    color: #3F5947;
+    background: #EEF4EC;
+    font-size: 12px;
+    padding: 11px 12px;
+    white-space: nowrap;
+}
+
+.tabela-resumo td {
+    padding: 11px 12px;
+    color: #444;
+    border-top: 1px solid #E4ECE2;
+    vertical-align: top;
+}
+
+.tabela-resumo .direita {
+    text-align: right;
+    white-space: nowrap;
+}
+
+.tabela-resumo .valor {
+    font-weight: bold;
+    color: #315C3A;
+}
+
+.tabela-resumo .valor-perda {
+    font-weight: bold;
+    color: #A63C39;
+}
+
+.etiqueta {
+    display: inline-block;
+    background: #EEF4EC;
+    color: #3F5947;
+    border-radius: 20px;
+    padding: 3px 10px;
+    font-size: 11px;
+    white-space: nowrap;
+}
+
+
+/* SEM REGISTROS */
+
+.vazio {
+    background: white;
+    border-radius: 8px;
+    padding: 34px 18px;
+    text-align: center;
+    color: #777;
+}
+
+.vazio i {
+    font-size: 38px;
+    color: #5E8F66;
+    margin-bottom: 12px;
+}
+
+.vazio h3 {
+    color: #2E2E2E;
+    font-size: 17px;
+    margin-bottom: 6px;
+}
+
+.vazio p {
+    font-size: 13px;
+}
+
+
+@media (max-width: 700px) {
+
+    .cards-resumo {
+        grid-template-columns: 1fr;
+    }
+
+    .btn-novo {
+        width: 100%;
+        justify-content: center;
+    }
+}
