+++ b/src/utils/formatar.js
@@ -0,0 +1,68 @@
+// Funções de formatação usadas nas telas e nos PDFs
+
+// "2026-09-14" -> "14/09/2026"
+function formatarData(valor) {
+    if (!valor) {
+        return "";
+    }
+
+    const texto = String(valor).slice(0, 10);
+    const partes = texto.split("-");
+
+    if (partes.length !== 3) {
+        return texto;
+    }
+
+    return `${partes[2]}/${partes[1]}/${partes[0]}`;
+}
+
+// 1234.5 -> "R$ 1.234,50"
+function formatarMoeda(valor) {
+    return Number(valor || 0).toLocaleString("pt-BR", {
+        style: "currency",
+        currency: "BRL"
+    });
+}
+
+// 12.5 -> "12,5"   (até 2 casas decimais)
+function formatarNumero(valor) {
+    return Number(valor || 0).toLocaleString("pt-BR", {
+        maximumFractionDigits: 2
+    });
+}
+
+// Data de hoje no formato AAAA-MM-DD, no horário de São Paulo
+function hojeISO() {
+    return new Date().toLocaleDateString("sv-SE", {
+        timeZone: "America/Sao_Paulo"
+    });
+}
+
+// Data e hora atuais para rodapé dos PDFs: "05/10/2026 21:10"
+function agoraTexto() {
+    return new Date().toLocaleString("pt-BR", {
+        timeZone: "America/Sao_Paulo",
+        dateStyle: "short",
+        timeStyle: "short"
+    }).replace(",", "");
+}
+
+// Valida "AAAA-MM-DD" (e se a data realmente existe)
+function dataValida(texto) {
+    if (typeof texto !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(texto)) {
+        return false;
+    }
+
+    const data = new Date(texto + "T00:00:00Z");
+
+    return !isNaN(data.getTime()) && data.toISOString().slice(0, 10) === texto;
+}
+
+module.exports = {
+    formatarData,
+    formatarMoeda,
+    formatarNumero,
+    hojeISO,
+    agoraTexto,
+    dataValida
+};
diff --git a/src/utils/pdf.js b/src/utils/pdf.js
new file mode 100644
index 0000000..912fdbe
--- /dev/null
+++ b/src/utils/pdf.js
@@ -0,0 +1,368 @@
+// ==========================================
+// GERADOR DE PDF SIMPLES (sem dependências)
+// ==========================================
+// Monta um PDF de relatório (título, período, tabela e totais) usando as
+// fontes padrão do PDF (Helvetica), que não precisam ser incluídas no arquivo.
+
+const LARGURA_PAGINA = 595.28; // A4
+const ALTURA_PAGINA = 841.89;
+const MARGEM = 40;
+
+const COR_VERDE = [0.19, 0.36, 0.23];   // #315C3A
+const COR_FUNDO_CABECALHO = [0.87, 0.91, 0.85]; // #DDE8D8
+const COR_LINHA = [0.77, 0.82, 0.78];
+
+// Largura dos caracteres da Helvetica (unidades de 1/1000 do tamanho da fonte)
+const LARGURAS = {
+    " ": 278, "!": 278, '"': 355, "#": 556, "$": 556, "%": 889, "&": 667, "'": 191,
+    "(": 333, ")": 333, "*": 389, "+": 584, ",": 278, "-": 333, ".": 278, "/": 278,
+    "0": 556, "1": 556, "2": 556, "3": 556, "4": 556, "5": 556, "6": 556, "7": 556,
+    "8": 556, "9": 556, ":": 278, ";": 278, "<": 584, "=": 584, ">": 584, "?": 556,
+    "@": 1015, "A": 667, "B": 667, "C": 722, "D": 722, "E": 667, "F": 611, "G": 778,
+    "H": 722, "I": 278, "J": 500, "K": 667, "L": 556, "M": 833, "N": 722, "O": 778,
+    "P": 667, "Q": 778, "R": 722, "S": 667, "T": 611, "U": 722, "V": 667, "W": 944,
+    "X": 667, "Y": 667, "Z": 611, "[": 278, "\\": 278, "]": 278, "^": 469, "_": 556,
+    "`": 333, "a": 556, "b": 556, "c": 500, "d": 556, "e": 556, "f": 278, "g": 556,
+    "h": 556, "i": 222, "j": 222, "k": 500, "l": 222, "m": 833, "n": 556, "o": 556,
+    "p": 556, "q": 556, "r": 333, "s": 500, "t": 278, "u": 556, "v": 500, "w": 722,
+    "x": 500, "y": 500, "z": 500, "{": 334, "|": 260, "}": 334, "~": 584
+};
+
+// Deixa só caracteres que a fonte padrão consegue mostrar (Latin-1)
+function limparTexto(texto) {
+    return String(texto === null || texto === undefined ? "" : texto)
+        .replace(/[\r\n\t]+/g, " ")
+        .replace(/[“”]/g, '"')
+        .replace(/[‘’]/g, "'")
+        .replace(/[–—]/g, "-")
+        .replace(/[^\x20-\x7E\xA0-\xFF]/g, "?");
+}
+
+function larguraDoCaractere(caractere) {
+    if (LARGURAS[caractere]) {
+        return LARGURAS[caractere];
+    }
+
+    // Letras acentuadas têm a mesma largura da letra sem acento
+    const base = caractere.normalize("NFD").charAt(0);
+
+    return LARGURAS[base] || 556;
+}
+
+function larguraDoTexto(texto, tamanho, negrito) {
+    let total = 0;
+
+    for (const caractere of texto) {
+        total += larguraDoCaractere(caractere);
+    }
+
+    return (total / 1000) * tamanho * (negrito ? 1.06 : 1);
+}
+
+// Quebra o texto em linhas que caibam na largura indicada
+function quebrarTexto(texto, largura, tamanho, negrito) {
+    const palavras = limparTexto(texto).split(" ").filter(Boolean);
+    const linhas = [];
+    let atual = "";
+
+    function cabe(t) {
+        return larguraDoTexto(t, tamanho, negrito) <= largura;
+    }
+
+    palavras.forEach((palavra) => {
+        let candidata = atual ? atual + " " + palavra : palavra;
+
+        if (cabe(candidata)) {
+            atual = candidata;
+            return;
+        }
+
+        if (atual) {
+            linhas.push(atual);
+            atual = "";
+        }
+
+        // Palavra maior que a coluna: corta em pedaços
+        while (!cabe(palavra)) {
+            let corte = palavra.length - 1;
+
+            while (corte > 1 && !cabe(palavra.slice(0, corte))) {
+                corte--;
+            }
+
+            linhas.push(palavra.slice(0, corte));
+            palavra = palavra.slice(corte);
+        }
+
+        atual = palavra;
+    });
+
+    if (atual) {
+        linhas.push(atual);
+    }
+
+    return linhas.length ? linhas : [""];
+}
+
+function escaparPdf(texto) {
+    return texto.replace(/\\/g, "\\\\").replace(/\(/g, "\\(").replace(/\)/g, "\\)");
+}
+
+function numero(valor) {
+    return Number(valor.toFixed(2)).toString();
+}
+
+// Uma página em construção: junta os comandos de desenho
+class Pagina {
+    constructor() {
+        this.comandos = [];
+    }
+
+    // y é medido do TOPO da página (mais natural para quem escreve o código)
+    texto(x, y, conteudo, { tamanho = 10, negrito = false, cor = [0, 0, 0] } = {}) {
+        const limpo = escaparPdf(limparTexto(conteudo));
+
+        this.comandos.push(
+            `${cor.map(numero).join(" ")} rg ` +
+            `BT /${negrito ? "F2" : "F1"} ${tamanho} Tf ` +
+            `${numero(x)} ${numero(ALTURA_PAGINA - y)} Td (${limpo}) Tj ET`
+        );
+    }
+
+    retangulo(x, y, largura, altura, cor) {
+        this.comandos.push(
+            `${cor.map(numero).join(" ")} rg ` +
+            `${numero(x)} ${numero(ALTURA_PAGINA - y - altura)} ${numero(largura)} ${numero(altura)} re f`
+        );
+    }
+
+    linha(x1, y, x2, cor, espessura = 0.5) {
+        this.comandos.push(
+            `${cor.map(numero).join(" ")} RG ${espessura} w ` +
+            `${numero(x1)} ${numero(ALTURA_PAGINA - y)} m ${numero(x2)} ${numero(ALTURA_PAGINA - y)} l S`
+        );
+    }
+}
+
+/**
+ * opcoes = {
+ *   titulo:    "Relatório de Vendas",
+ *   subtitulo: "Período: 01/09/2026 a 30/09/2026",
+ *   colunas:   [{ titulo: "Produto", largura: 0.4, alinhar: "esquerda" | "direita" }],
+ *   linhas:    [["Leite", "200", "R$ 500,00"], ...],
+ *   resumo:    ["Total de registros: 3", "Valor total: R$ 870,00"],
+ *   geradoEm:  "05/10/2026 21:10"
+ * }
+ * (a soma das larguras das colunas deve ser 1)
+ */
+function gerarPdfRelatorio(opcoes) {
+    const colunas = opcoes.colunas;
+    const larguraUtil = LARGURA_PAGINA - MARGEM * 2;
+    const tamanhoTexto = 9;
+    const alturaLinha = 12;
+    const paddingCelula = 5;
+
+    const larguras = colunas.map((c) => c.largura * larguraUtil);
+    const limiteInferior = ALTURA_PAGINA - MARGEM - 25; // deixa espaço para o rodapé
+
+    const paginas = [];
+    let pagina = null;
+    let y = 0;
+
+    function desenharCabecalhoTabela() {
+        pagina.retangulo(MARGEM, y, larguraUtil, 20, COR_FUNDO_CABECALHO);
+
+        let x = MARGEM;
+
+        colunas.forEach((coluna, i) => {
+            const titulo = limparTexto(coluna.titulo);
+            const larguraTexto = larguraDoTexto(titulo, tamanhoTexto, true);
+            const posX = coluna.alinhar === "direita"
+                ? x + larguras[i] - paddingCelula - larguraTexto
+                : x + paddingCelula;
+
+            pagina.texto(posX, y + 14, titulo, {
+                tamanho: tamanhoTexto, negrito: true, cor: COR_VERDE
+            });
+
+            x += larguras[i];
+        });
+
+        y += 20;
+    }
+
+    function novaPagina(primeira) {
+        pagina = new Pagina();
+        paginas.push(pagina);
+
+        y = MARGEM;
+
+        // Barra de título
+        pagina.retangulo(0, 0, LARGURA_PAGINA, 6, COR_VERDE);
+        pagina.texto(MARGEM, y + 14, "Rural Tech", {
+            tamanho: 11, negrito: true, cor: COR_VERDE
+        });
+
+        const textoGerado = "Gerado em " + opcoes.geradoEm;
+
+        pagina.texto(
+            LARGURA_PAGINA - MARGEM - larguraDoTexto(textoGerado, 8, false),
+            y + 13,
+            textoGerado,
+            { tamanho: 8, cor: [0.4, 0.4, 0.4] }
+        );
+
+        y += 34;
+
+        if (primeira) {
+            pagina.texto(MARGEM, y + 14, opcoes.titulo, {
+                tamanho: 18, negrito: true, cor: [0.18, 0.18, 0.18]
+            });
+            y += 24;
+
+            if (opcoes.subtitulo) {
+                pagina.texto(MARGEM, y + 10, opcoes.subtitulo, {
+                    tamanho: 10, cor: [0.4, 0.4, 0.4]
+                });
+                y += 22;
+            }
+
+            y += 6;
+        }
+
+        desenharCabecalhoTabela();
+    }
+
+    novaPagina(true);
+
+    opcoes.linhas.forEach((linha) => {
+        // Quebra o texto de cada célula e descobre a altura da linha
+        const celulas = linha.map((valor, i) =>
+            quebrarTexto(valor, larguras[i] - paddingCelula * 2, tamanhoTexto, false)
+        );
+
+        const qtdLinhas = Math.max(...celulas.map((c) => c.length));
+        const altura = qtdLinhas * alturaLinha + 8;
+
+        if (y + altura > limiteInferior) {
+            novaPagina(false);
+        }
+
+        let x = MARGEM;
+
+        celulas.forEach((linhasDaCelula, i) => {
+            linhasDaCelula.forEach((texto, j) => {
+                const larguraTexto = larguraDoTexto(texto, tamanhoTexto, false);
+                const posX = colunas[i].alinhar === "direita"
+                    ? x + larguras[i] - paddingCelula - larguraTexto
+                    : x + paddingCelula;
+
+                pagina.texto(posX, y + 4 + (j + 1) * alturaLinha - 3, texto, {
+                    tamanho: tamanhoTexto,
+                    cor: [0.18, 0.18, 0.18]
+                });
+            });
+
+            x += larguras[i];
+        });
+
+        y += altura;
+        pagina.linha(MARGEM, y, MARGEM + larguraUtil, COR_LINHA);
+    });
+
+    // Resumo / totais no final
+    if (opcoes.resumo && opcoes.resumo.length) {
+        const alturaResumo = opcoes.resumo.length * 16 + 20;
+
+        if (y + alturaResumo > limiteInferior) {
+            novaPagina(false);
+        }
+
+        y += 18;
+
+        opcoes.resumo.forEach((texto) => {
+            pagina.texto(MARGEM, y, texto, {
+                tamanho: 10, negrito: true, cor: COR_VERDE
+            });
+            y += 16;
+        });
+    }
+
+    // Rodapé com número da página
+    paginas.forEach((p, indice) => {
+        const texto = `Página ${indice + 1} de ${paginas.length}`;
+
+        p.linha(MARGEM, ALTURA_PAGINA - MARGEM - 10, LARGURA_PAGINA - MARGEM, COR_LINHA);
+        p.texto(
+            LARGURA_PAGINA - MARGEM - larguraDoTexto(texto, 8, false),
+            ALTURA_PAGINA - MARGEM + 4,
+            texto,
+            { tamanho: 8, cor: [0.4, 0.4, 0.4] }
+        );
+    });
+
+    return montarArquivoPdf(paginas, opcoes.titulo);
+}
+
+// Monta a estrutura do arquivo PDF (objetos, tabela de referências)
+function montarArquivoPdf(paginas, titulo) {
+    const objetos = []; // índice 0 = objeto 1
+
+    // 1: catálogo, 2: lista de páginas, 3 e 4: fontes
+    const idsPaginas = [];
+    const primeiroIdPagina = 5;
+
+    paginas.forEach((_, i) => {
+        idsPaginas.push(primeiroIdPagina + i * 2);
+    });
+
+    objetos[0] = "<< /Type /Catalog /Pages 2 0 R >>";
+    objetos[1] = `<< /Type /Pages /Kids [${idsPaginas.map((id) => id + " 0 R").join(" ")}] /Count ${paginas.length} >>`;
+    objetos[2] = "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>";
+    objetos[3] = "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>";
+
+    paginas.forEach((p, i) => {
+        const idPagina = primeiroIdPagina + i * 2;
+        const idConteudo = idPagina + 1;
+        const conteudo = p.comandos.join("\n");
+
+        objetos[idPagina - 1] =
+            `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${LARGURA_PAGINA} ${ALTURA_PAGINA}] ` +
+            `/Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents ${idConteudo} 0 R >>`;
+
+        objetos[idConteudo - 1] =
+            `<< /Length ${Buffer.byteLength(conteudo, "latin1")} >>\nstream\n${conteudo}\nendstream`;
+    });
+
+    // Informações do documento
+    const idInfo = objetos.length + 1;
+    objetos[idInfo - 1] =
+        `<< /Title (${escaparPdf(limparTexto(titulo))}) /Producer (Rural Tech) >>`;
+
+    const partes = [Buffer.from("%PDF-1.4\n%\xE2\xE3\xCF\xD3\n", "latin1")];
+    const posicoes = [];
+    let tamanhoAtual = partes[0].length;
+
+    objetos.forEach((conteudo, i) => {
+        const bloco = Buffer.from(`${i + 1} 0 obj\n${conteudo}\nendobj\n`, "latin1");
+
+        posicoes.push(tamanhoAtual);
+        partes.push(bloco);
+        tamanhoAtual += bloco.length;
+    });
+
+    let xref = `xref\n0 ${objetos.length + 1}\n0000000000 65535 f \n`;
+
+    posicoes.forEach((posicao) => {
+        xref += String(posicao).padStart(10, "0") + " 00000 n \n";
+    });
+
+    xref += `trailer\n<< /Size ${objetos.length + 1} /Root 1 0 R /Info ${idInfo} 0 R >>\n`;
+    xref += `startxref\n${tamanhoAtual}\n%%EOF\n`;
+
+    partes.push(Buffer.from(xref, "latin1"));
+
+    return Buffer.concat(partes);
+}
+
+module.exports = { gerarPdfRelatorio };
