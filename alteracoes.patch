@@ -0,0 +1,156 @@
+// ==========================================
+// SESSÃO DO USUÁRIO (cookie assinado)
+// ==========================================
+// Guarda quem está logado em um cookie assinado com HMAC (módulo "crypto"
+// do próprio Node), sem precisar de nenhum pacote extra.
+//
+// Para manter o login mesmo depois de reiniciar o servidor, defina a
+// variável de ambiente SESSION_SECRET. Sem ela, um segredo aleatório é
+// criado a cada início do servidor (e todos precisam entrar de novo).
+
+const crypto = require("crypto");
+const conexao = require("../config/db");
+
+const NOME_COOKIE = "rt_sessao";
+const DURACAO_SEGUNDOS = 8 * 60 * 60; // 8 horas
+
+const segredo = process.env.SESSION_SECRET || crypto.randomBytes(32).toString("hex");
+
+function assinar(texto) {
+    return crypto.createHmac("sha256", segredo).update(texto).digest("base64url");
+}
+
+function lerCookies(req) {
+    const resultado = {};
+    const cabecalho = req.headers.cookie || "";
+
+    cabecalho.split(";").forEach((parte) => {
+        const posicao = parte.indexOf("=");
+
+        if (posicao === -1) {
+            return;
+        }
+
+        const chave = parte.slice(0, posicao).trim();
+        const valor = parte.slice(posicao + 1).trim();
+
+        resultado[chave] = valor;
+    });
+
+    return resultado;
+}
+
+// Devolve o id do usuário se o cookie for válido, ou null
+function lerIdDoCookie(req) {
+    const cookie = lerCookies(req)[NOME_COOKIE];
+
+    if (!cookie) {
+        return null;
+    }
+
+    const partes = cookie.split(".");
+
+    if (partes.length !== 2) {
+        return null;
+    }
+
+    const [conteudo, assinatura] = partes;
+    const esperada = assinar(conteudo);
+
+    const a = Buffer.from(assinatura);
+    const b = Buffer.from(esperada);
+
+    if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {
+        return null;
+    }
+
+    try {
+        const dados = JSON.parse(Buffer.from(conteudo, "base64url").toString("utf8"));
+
+        if (!dados.id || dados.exp < Date.now()) {
+            return null;
+        }
+
+        return dados.id;
+    } catch (erro) {
+        return null;
+    }
+}
+
+function iniciarSessao(res, idUsuario) {
+    const conteudo = Buffer.from(
+        JSON.stringify({ id: idUsuario, exp: Date.now() + DURACAO_SEGUNDOS * 1000 })
+    ).toString("base64url");
+
+    res.append(
+        "Set-Cookie",
+        `${NOME_COOKIE}=${conteudo}.${assinar(conteudo)}; Path=/; HttpOnly; SameSite=Lax; Max-Age=${DURACAO_SEGUNDOS}`
+    );
+}
+
+function encerrarSessao(res) {
+    res.append(
+        "Set-Cookie",
+        `${NOME_COOKIE}=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0`
+    );
+}
+
+// Carrega o usuário logado (com os dados atuais do banco) em req.usuario
+async function carregarUsuario(req) {
+    const id = lerIdDoCookie(req);
+
+    if (!id) {
+        return null;
+    }
+
+    const linhas = await conexao.consultar(
+        "SELECT id_usuario, nome, email, telefone FROM usuarios WHERE id_usuario = ?",
+        [id]
+    );
+
+    return linhas[0] || null;
+}
+
+// Para PÁGINAS: se não estiver logado, manda para o login
+async function paginaProtegida(req, res, next) {
+    try {
+        const usuario = await carregarUsuario(req);
+
+        if (!usuario) {
+            return res.redirect("/login");
+        }
+
+        req.usuario = usuario;
+        res.locals.usuario = usuario;
+
+        next();
+    } catch (erro) {
+        next(erro);
+    }
+}
+
+// Para ROTAS DE DADOS (JSON/PDF): se não estiver logado, responde 401
+async function apiProtegida(req, res, next) {
+    try {
+        const usuario = await carregarUsuario(req);
+
+        if (!usuario) {
+            return res.status(401).json({
+                erro: "Sessão expirada. Faça login novamente."
+            });
+        }
+
+        req.usuario = usuario;
+
+        next();
+    } catch (erro) {
+        next(erro);
+    }
+}
+
+module.exports = {
+    iniciarSessao,
+    encerrarSessao,
+    paginaProtegida,
+    apiProtegida
+};
diff --git a/src/routes/conta.js b/src/routes/conta.js
new file mode 100644
index 0000000..8d9b396
--- /dev/null
+++ b/src/routes/conta.js
@@ -0,0 +1,166 @@
+// ==========================================
+// CONTA DO USUÁRIO (configurações)
+// ==========================================
+//   GET  /configuracoes      -> tela de configurações
+//   GET  /editar-perfil      -> tela de edição do perfil
+//   PUT  /api/perfil         -> salva nome, e-mail e telefone
+//   GET  /alterar-senha      -> tela de troca de senha
+//   POST /api/alterar-senha  -> troca a senha
+//   GET  /sair               -> encerra a sessão
+
+const express = require("express");
+const conexao = require("../config/db");
+const {
+    paginaProtegida,
+    apiProtegida,
+    encerrarSessao
+} = require("../middleware/sessao");
+
+const router = express.Router();
+
+// Mesmas regras da tela de cadastro: 8+ caracteres, 1 maiúscula, 1 especial
+const CARACTERES_ESPECIAIS = "!@#$%^&*(),.?\":{}|<>-";
+
+function validarSenhaNova(senha) {
+    if (senha.length < 8) {
+        return "A senha deve ter pelo menos 8 caracteres.";
+    }
+
+    if (senha.length > 255) {
+        return "A senha é muito longa.";
+    }
+
+    let temMaiuscula = false;
+    let temEspecial = false;
+
+    for (const caractere of senha) {
+        if (caractere >= "A" && caractere <= "Z") {
+            temMaiuscula = true;
+        } else if (CARACTERES_ESPECIAIS.includes(caractere)) {
+            temEspecial = true;
+        }
+    }
+
+    if (!temMaiuscula || !temEspecial) {
+        return "A senha deve conter pelo menos 1 letra maiúscula e 1 caractere especial.";
+    }
+
+    return null;
+}
+
+// ------------------------------------------
+// TELAS
+// ------------------------------------------
+router.get("/configuracoes", paginaProtegida, (req, res) => {
+    res.render("configuracoes");
+});
+
+router.get("/editar-perfil", paginaProtegida, (req, res) => {
+    res.render("editar_perfil");
+});
+
+router.get("/alterar-senha", paginaProtegida, (req, res) => {
+    res.render("alterar_senha");
+});
+
+router.get("/sair", (req, res) => {
+    encerrarSessao(res);
+    res.redirect("/login");
+});
+
+// ------------------------------------------
+// EDITAR PERFIL
+// ------------------------------------------
+router.put("/api/perfil", apiProtegida, async (req, res, next) => {
+    try {
+        const corpo = req.body || {};
+
+        const nome = String(corpo.nome || "").trim();
+        const email = String(corpo.email || "").trim().toLowerCase();
+        const telefone = String(corpo.telefone || "").trim();
+
+        if (nome === "" || nome.length > 100) {
+            return res.status(400).json({ erro: "Informe seu nome (até 100 caracteres)." });
+        }
+
+        if (email === "" || email.length > 150 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+            return res.status(400).json({ erro: "Informe um e-mail válido." });
+        }
+
+        if (telefone.length > 20 || !/^[0-9()+\-\s]*$/.test(telefone)) {
+            return res.status(400).json({
+                erro: "Telefone inválido. Use apenas números, espaços, parênteses, + e -."
+            });
+        }
+
+        await conexao.consultar(
+            "UPDATE usuarios SET nome = ?, email = ?, telefone = ? WHERE id_usuario = ?",
+            [nome, email, telefone || null, req.usuario.id_usuario]
+        );
+
+        res.json({ nome, email, telefone });
+    } catch (erro) {
+        if (erro && erro.code === "ER_DUP_ENTRY") {
+            return res.status(409).json({ erro: "Este e-mail já está sendo usado por outra conta." });
+        }
+
+        next(erro);
+    }
+});
+
+// ------------------------------------------
+// ALTERAR SENHA
+// ------------------------------------------
+router.post("/api/alterar-senha", apiProtegida, async (req, res, next) => {
+    try {
+        const corpo = req.body || {};
+
+        const senhaAtual = String(corpo.senhaAtual || "");
+        const novaSenha = String(corpo.novaSenha || "");
+        const confirmarSenha = String(corpo.confirmarSenha || "");
+
+        if (senhaAtual === "") {
+            return res.status(400).json({ erro: "Digite sua senha atual." });
+        }
+
+        if (novaSenha === "") {
+            return res.status(400).json({ erro: "Digite uma nova senha." });
+        }
+
+        if (novaSenha !== confirmarSenha) {
+            return res.status(400).json({ erro: "As novas senhas não são iguais." });
+        }
+
+        const erroSenha = validarSenhaNova(novaSenha);
+
+        if (erroSenha) {
+            return res.status(400).json({ erro: erroSenha });
+        }
+
+        // Confere a senha atual (comparada aqui no JS, para diferenciar
+        // maiúsculas de minúsculas — o MySQL ignoraria isso no WHERE)
+        const usuarios = await conexao.consultar(
+            "SELECT senha FROM usuarios WHERE id_usuario = ?",
+            [req.usuario.id_usuario]
+        );
+
+        if (usuarios.length === 0 || usuarios[0].senha !== senhaAtual) {
+            return res.status(400).json({ erro: "A senha atual está incorreta." });
+        }
+
+        if (novaSenha === senhaAtual) {
+            return res.status(400).json({ erro: "A nova senha deve ser diferente da atual." });
+        }
+
+        await conexao.consultar(
+            "UPDATE usuarios SET senha = ? WHERE id_usuario = ?",
+            [novaSenha, req.usuario.id_usuario]
+        );
+
+        res.json({ mensagem: "Senha alterada com sucesso!" });
+    } catch (erro) {
+        next(erro);
+    }
+});
+
+module.exports = router;
