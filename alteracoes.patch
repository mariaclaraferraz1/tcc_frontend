+<!DOCTYPE html>
+<html lang="pt-BR">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+
+    <title>Rural Tech - Gastos</title>
+
+    <link rel="stylesheet" href="/css/style.css" />
+    <link rel="stylesheet" href="/css/resumo.css" />
+
+    <link
+      rel="stylesheet"
+      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
+    />
+  </head>
+
+  <body>
+    <%- include('partials/menu') %>
+
+    <!-- CABEÇALHO -->
+    <header>
+      <button class="menu-btn" id="menuBtn">
+        <i class="fa-solid fa-bars"></i>
+      </button>
+
+      <img src="/img/logotcc.png" alt="Logo Rural Tech" />
+
+      <h2>Rural Tech</h2>
+    </header>
+
+    <!-- CONTEÚDO -->
+    <main>
+      <section class="cabecalho-resumo">
+        <h1>
+          <i class="fa-solid fa-money-bill-wave"></i>
+          Gastos registrados
+        </h1>
+
+        <p>Veja os gastos já registrados antes de lançar um novo.</p>
+      </section>
+
+      <!-- TOTAIS -->
+      <section class="cards-resumo">
+        <div class="card-total">
+          <span>Gastos registrados</span>
+          <strong><%= totalRegistros %></strong>
+        </div>
+
+        <div class="card-total alerta">
+          <span>Total gasto no mês atual</span>
+          <strong><%= formatarMoeda(totalMes) %></strong>
+        </div>
+
+        <div class="card-total alerta">
+          <span>Total gasto (geral)</span>
+          <strong><%= formatarMoeda(totalGeral) %></strong>
+        </div>
+      </section>
+
+      <!-- LISTA -->
+      <section class="card-lista">
+        <div class="topo-lista">
+          <h2>Histórico de gastos</h2>
+
+          <a href="/controle-de-gastos/registrar" class="btn-novo">
+            <i class="fa-solid fa-plus"></i>
+            Registrar novo gasto
+          </a>
+        </div>
+
+        <% if (gastos.length === 0) { %>
+          <div class="vazio">
+            <i class="fa-solid fa-receipt"></i>
+            <h3>Nenhum gasto registrado</h3>
+            <p>Quando você registrar um gasto, ele aparecerá aqui.</p>
+          </div>
+        <% } else { %>
+          <div class="tabela-rolagem">
+            <table class="tabela-resumo">
+              <thead>
+                <tr>
+                  <th>Data</th>
+                  <th>Descrição</th>
+                  <th>Categoria</th>
+                  <th>Pagamento</th>
+                  <th class="direita">Valor</th>
+                </tr>
+              </thead>
+
+              <tbody>
+                <% gastos.forEach(function (gasto) { %>
+                  <tr>
+                    <td><%= formatarData(gasto.data_gasto) %></td>
+                    <td>
+                      <%= gasto.descricao %>
+                      <% if (gasto.fornecedor) { %>
+                        <br /><small style="color:#777"><%= gasto.fornecedor %></small>
+                      <% } %>
+                    </td>
+                    <td>
+                      <% if (gasto.categoria) { %>
+                        <span class="etiqueta"><%= gasto.categoria %></span>
+                      <% } else { %>
+                        -
+                      <% } %>
+                    </td>
+                    <td><%= gasto.forma_pagamento || "-" %></td>
+                    <td class="direita valor-perda">
+                      <%= formatarMoeda(gasto.valor) %>
+                    </td>
+                  </tr>
+                <% }); %>
+              </tbody>
+            </table>
+          </div>
+        <% } %>
+      </section>
+    </main>
+
+    <script src="/js/menu_lateral.js"></script>
+  </body>
+</html>
