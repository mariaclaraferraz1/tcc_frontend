<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rural Tech - Alterar Senha</title>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/alterar_senha.css" />
  </head>

  <body>
    <!-- MENU LATERAL -->

    <%- include('partials/menu') %>

    <!-- CABEÇALHO -->

    <header>
      <button class="menu-btn" id="menuBtn">
        <i class="fa-solid fa-bars"></i>
      </button>

      <img src="/img/logotcc.png" alt="Logo Rural Tech" />

      <h2>Rural Tech</h2>
    </header>

    <!-- CONTEÚDO -->

    <main>
      <section class="cabecalho-pagina">
        <span class="subtitulo">CONFIGURAÇÕES</span>

        <h1>Alterar senha</h1>

        <p>Atualize a senha para manter sua conta protegida.</p>
      </section>

      <section class="senha-card">
        <div class="titulo-card">
          <div class="icone-senha">
            <i class="fa-solid fa-lock"></i>
          </div>

          <div>
            <h2>Segurança da conta</h2>

            <p>Informe sua senha atual e escolha uma nova senha.</p>
          </div>
        </div>

        <form id="formSenha">
          <div class="campo">
            <label for="senhaAtual"> Senha atual </label>

            <input
              type="password"
              id="senhaAtual"
              placeholder="Digite sua senha atual"
              required
            />
          </div>

          <div class="campo">
            <label for="novaSenha"> Nova senha </label>

            <input
              type="password"
              id="novaSenha"
              placeholder="Digite sua nova senha"
              required
            />
          </div>

          <div class="campo">
            <label for="confirmarSenha"> Confirmar nova senha </label>

            <input
              type="password"
              id="confirmarSenha"
              placeholder="Digite novamente a nova senha"
              required
            />
          </div>

          <div class="botoes">
            <a href="/configuracoes" class="btn-cancelar"> Cancelar </a>

            <button type="submit" class="btn-salvar">
              <i class="fa-solid fa-check"></i>

              Alterar senha
            </button>
          </div>
        </form>
      </section>
    </main>

    <script src="/js/menu_lateral.js"></script>
    <script src="/js/alterar_senha.js"></script>
  </body>
</html>
