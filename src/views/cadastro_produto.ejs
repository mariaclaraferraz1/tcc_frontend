<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rural Tech</title>

    <!-- Removido o ../ do CSS -->
    <link rel="stylesheet" href="/css/cadastro_produto.css" />
    <link rel="stylesheet" href="/css/style.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <%- include('partials/menu') %>

    <header>
      <button class="menu-btn" id="menuBtn">
        <i class="fa-solid fa-bars"></i>
      </button>

      <!-- Removido o ../ da imagem -->
      <img src="/img/logotcc.png" alt="Logo Rural Tech" />

      <h2>Rural Tech</h2>
    </header>

    <main>
      <!-- Mudado de 'produtos.html' para a ROTA '/produtos' -->
      <a href="/produtos" class="btn-voltar">
        <i class="fa-solid fa-arrow-left"></i>
        Voltar para produtos
      </a>

      <h1>
        <i class="fa-solid fa-box"></i>
        Cadastro de Produtos
      </h1>

      
<form id="form-produto">
  <label for="nome">Nome do Produto</label>
  <input type="text" id="nome" required />

  <label for="preco">Preço</label>
  <input type="number" id="preco" min="0" step="0.01" required />

  <label for="categoria">Categoria</label>
  <input type="text" id="categoria" required />

  <label for="imagem">Imagem do Produto</label>
  <input type="file" id="imagem" accept="image/*" />

  <img
    id="preview-imagem"
    alt="Prévia da imagem escolhida"
    style="display:none; width:200px; max-width:100%; margin-top:10px; border-radius:8px;"
  />

  <button type="submit">Salvar Produto</button>
</form>
    </main>

    <!-- Removido o ../ dos scripts JS -->
    <script src="/js/menu_lateral.js"></script>
    <script src="/js/cadastro.js"></script>
  </body>
</html>
