<%- include('partials/head', { titulo: titulo, css: [] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<%
    const dados = produto || {};
    const editando = Boolean(dados.id_produto);
    const imagemAtual = dados.imagem || "";
%>

<main class="painel-main">
    <%- include('partials/mensagens') %>

    <section class="painel-hero">
        <div>
            <span class="eyebrow">
                <i class="fa-solid fa-box"></i>
                Catálogo da propriedade
            </span>
            <h1><%= editando ? 'Editar produto' : 'Novo produto' %></h1>
            <p>Cadastre os dados do produto para usá-lo nas vendas, perdas, colheitas e relatórios.</p>
        </div>

        <div class="painel-hero-acoes">
            <a href="/produtos" class="painel-btn-secundario">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar para produtos
            </a>
        </div>
    </section>

    <form action="/cadastro-produto" method="POST" class="painel-form" id="form-produto" enctype="application/x-www-form-urlencoded">
        <% if (editando) { %>
            <input type="hidden" name="id" value="<%= dados.id_produto %>">
        <% } %>

        <div class="painel-dica">
            <i class="fa-solid fa-lightbulb"></i>
            <div>
                <strong>Preço e unidade são usados nas vendas</strong>
                <p>O valor unitário cadastrado aqui preenche automaticamente o registro de vendas. Você poderá ajustar o preço apenas no cadastro do produto.</p>
            </div>
        </div>

        <div class="form-grade">
            <div class="form-grupo largo">
                <label for="nome">Nome do produto *</label>
                <input type="text" id="nome" name="nome" maxlength="100" required value="<%= dados.nome || '' %>" placeholder="Ex: Milho safrinha">
            </div>

            <div class="form-grupo">
                <label for="categoria">Categoria</label>
                <input type="text" id="categoria" name="categoria" maxlength="100" list="categorias-produto" value="<%= dados.categoria || 'Grãos' %>" placeholder="Ex: Grãos">
                <datalist id="categorias-produto">
                    <% categorias.forEach(function (categoria) { %>
                        <option value="<%= categoria %>"></option>
                    <% }); %>
                </datalist>
            </div>

            <div class="form-grupo">
                <label for="unidade">Unidade de medida</label>
                <select id="unidade" name="unidade" required>
                    <% unidades.forEach(function (unidade) { %>
                        <option value="<%= unidade %>" <%= (dados.unidade || 'kg') === unidade ? 'selected' : '' %>><%= unidade %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-grupo">
                <label for="preco">Preço unitário (R$) *</label>
                <input type="number" id="preco" name="preco" min="0" step="0.01" required value="<%= dados.preco !== undefined && dados.preco !== null ? dados.preco : '' %>" placeholder="0,00">
            </div>

            <div class="form-grupo">
                <label for="estoque">Estoque disponível *</label>
                <input type="number" id="estoque" name="estoque" min="0" step="0.01" required value="<%= dados.estoque !== undefined && dados.estoque !== null ? dados.estoque : '' %>" placeholder="0">
                <small>O estoque é reduzido automaticamente quando uma venda é registrada.</small>
            </div>

            <div class="form-grupo largo">
                <label for="descricao">Descrição <span class="opcional">(opcional)</span></label>
                <input type="text" id="descricao" name="descricao" maxlength="255" value="<%= dados.descricao || '' %>" placeholder="Ex: Produção própria, grão seco">
            </div>

            <div class="form-grupo">
                <label for="arquivo-imagem">Imagem do produto <span class="opcional">(opcional)</span></label>
                <input type="file" id="arquivo-imagem" accept="image/png, image/jpeg, image/webp, image/gif">
                <small>PNG, JPG, WEBP ou GIF com até 2 MB.</small>
            </div>

            <div class="form-grupo">
                <label for="imagemLink">Ou informe um link de imagem</label>
                <input type="url" id="imagemLink" name="imagemLink" maxlength="1000" value="<%= (dados.imagem && !String(dados.imagem).startsWith('data:')) ? dados.imagem : '' %>" placeholder="https://...">
                <small>O arquivo enviado tem prioridade sobre o link.</small>
            </div>

            <div class="form-grupo largo">
                <input type="hidden" name="imagem" id="imagem-data" value="">
                <img
                    id="preview-imagem"
                    class="painel-preview"
                    alt="Prévia da imagem do produto"
                    src="<%= imagemAtual %>"
                    style="<%= imagemAtual ? '' : 'display:none;' %>"
                >
                <small>Se nenhuma nova imagem for informada, a imagem atual será mantida.</small>
            </div>
        </div>

        <div class="form-acoes">
            <a href="/produtos" class="painel-btn-secundario">
                <i class="fa-solid fa-xmark"></i>
                Cancelar
            </a>
            <button type="submit" class="painel-btn btn-salvar">
                <i class="fa-solid fa-check"></i>
                <%= editando ? 'Salvar alterações' : 'Cadastrar produto' %>
            </button>
        </div>
    </form>
</main>

<%- include('partials/scripts', { scripts: ['/js/cadastro.js'] }) %>
</body>
</html>
