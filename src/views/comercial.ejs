<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rural Tech - Comercial</title>

    <!-- Removido o ../ dos arquivos CSS -->
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/comercial.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <!-- MENU LATERAL -->
    <%- include('partials/menu') %>

    <!-- CABEÇALHO -->
    <header>
      <button class="menu-btn" id="menuBtn">
        <i class="fa-solid fa-bars"></i>
      </button>

      <!-- Removido o ../ da imagem -->
      <img src="/img/logotcc.png" alt="Logo Rural Tech" />

      <h2>Rural Tech</h2>
    </header>

    <!-- CONTEÚDO -->
    <main>
      <section class="cabecalho-comercial">
        <span class="subtitulo"> COMERCIAL </span>

        <h1>
          <i class="fa-solid fa-cart-shopping"></i>
          Comercial
        </h1>

        <p>Gerencie as vendas, gastos e resultados do seu negócio.</p>
      </section>

      <section class="opcoes-comercial">
        <h2>Gerenciamento comercial</h2>

        <div class="cards-comercial">
          <!-- REGISTRAR VENDA -->
          <a href="/registrar-vendas" class="card-comercial">
            <div class="icone">
              <i class="fa-solid fa-receipt"></i>
            </div>
            <div>
              <h3>Registrar Venda</h3>
              <p>Registre uma nova venda realizada.</p>
            </div>
          </a>

          <!-- VENDAS -->
          <a href="/vendas" class="card-comercial">
            <div class="icone">
              <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <div>
              <h3>Vendas</h3>
              <p>Consulte e acompanhe as vendas realizadas.</p>
            </div>
          </a>

          <!-- GASTOS -->
          <a href="/controle-de-gastos" class="card-comercial">
            <div class="icone">
              <i class="fa-solid fa-money-bill-wave"></i>
            </div>
            <div>
              <h3>Gastos</h3>
              <p>Registre e acompanhe os gastos do negócio.</p>
            </div>
          </a>

          <!-- LUCROS -->
          <a href="#" class="card-comercial">
            <div class="icone">
              <i class="fa-solid fa-chart-line"></i>
            </div>
            <div>
              <h3>Lucros</h3>
              <p>Acompanhe os resultados e os lucros.</p>
            </div>
          </a>

          <!-- PERDAS -->
          <a href="/perdas" class="card-comercial">
            <div class="icone">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
              <h3>Perdas</h3>
              <p>Registre e acompanhe as perdas da produção.</p>
            </div>
          </a>
        </div>
      </section>
    </main>

    <!-- JAVASCRIPT -->
    <script src="/js/menu_lateral.js"></script>
  </body>
</html>
