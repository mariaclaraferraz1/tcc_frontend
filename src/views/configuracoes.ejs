<%- include('partials/head', { titulo: titulo, css: [] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<main class="painel-main">
    <%- include('partials/mensagens') %>

    <section class="painel-hero">
        <div>
            <span class="eyebrow">
                <i class="fa-solid fa-gear"></i>
                Conta
            </span>
            <h1>Configurações</h1>
            <p>Gerencie o perfil, a senha e as preferências de notificação da sua conta.</p>
        </div>

        <div class="painel-hero-acoes">
            <a href="/inicio" class="painel-btn-secundario">
                <i class="fa-solid fa-house"></i>
                Início
            </a>
        </div>
    </section>

    <section class="painel-secao">
        <div class="painel-secao-topo">
            <div>
                <span class="painel-secao-label">
                    <i class="fa-solid fa-user"></i>
                    Perfil
                </span>
                <h2>Dados da conta</h2>
            </div>
        </div>

        <div class="painel-resumo">
            <div class="painel-card">
                <div class="painel-card-icone"><i class="fa-solid fa-user"></i></div>
                <div class="painel-card-info">
                    <span>Nome</span>
                    <strong><%= usuario.nome %></strong>
                    <small>Nome exibido no painel</small>
                </div>
            </div>

            <div class="painel-card">
                <div class="painel-card-icone"><i class="fa-solid fa-envelope"></i></div>
                <div class="painel-card-info">
                    <span>E-mail</span>
                    <strong style="font-size: 16px;"><%= usuario.email %></strong>
                    <small>Usado para entrar no sistema</small>
                </div>
            </div>

            <div class="painel-card">
                <div class="painel-card-icone"><i class="fa-solid fa-phone"></i></div>
                <div class="painel-card-info">
                    <span>Telefone</span>
                    <strong style="font-size: 18px;"><%= usuario.telefone || 'Não informado' %></strong>
                    <small>Contato da propriedade</small>
                </div>
            </div>
        </div>

        <div class="config-lista">
            <div class="config-item">
                <div>
                    <strong>Editar perfil</strong>
                    <span>Altere nome, e-mail e telefone da conta.</span>
                </div>
                <div class="acoes">
                    <a href="/editar-perfil" class="painel-btn painel-btn-mini">
                        <i class="fa-solid fa-pen"></i>
                        Editar perfil
                    </a>
                </div>
            </div>

            <div class="config-item">
                <div>
                    <strong>Alterar senha</strong>
                    <span>Informe a senha atual, a nova senha e a confirmação.</span>
                </div>
                <div class="acoes">
                    <a href="/alterar-senha" class="painel-btn-secundario painel-btn-mini">
                        <i class="fa-solid fa-key"></i>
                        Alterar senha
                    </a>
                </div>
            </div>

            <div class="config-item">
                <div>
                    <strong>Conta criada em</strong>
                    <span><%= formatarData(usuario.criado_em) %></span>
                </div>
            </div>
        </div>
    </section>

    <section class="painel-secao">
        <div class="painel-secao-topo">
            <div>
                <span class="painel-secao-label">
                    <i class="fa-solid fa-bell"></i>
                    Preferências
                </span>
                <h2>Notificações</h2>
            </div>
        </div>

        <form action="/configuracoes/notificacoes" method="POST">
            <div class="config-lista">
                <div class="config-item">
                    <div>
                        <strong>Notificações do sistema</strong>
                        <span>Receber avisos importantes sobre estoque, vendas e perdas.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="notificacoesSistema" value="1" <%= Number(usuario.notificacoes_sistema || 0) ? 'checked' : '' %>>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="config-item">
                    <div>
                        <strong>Lembretes</strong>
                        <span>Receber lembretes de plantio, colheita e registros pendentes.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="lembretes" value="1" <%= Number(usuario.lembretes || 0) ? 'checked' : '' %>>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <div class="form-acoes">
                <button type="submit" class="painel-btn">
                    <i class="fa-solid fa-check"></i>
                    Salvar preferências
                </button>
            </div>
        </form>
    </section>

    <section class="painel-secao">
        <div class="painel-secao-topo">
            <div>
                <span class="painel-secao-label">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Sessão
                </span>
                <h2>Encerrar acesso</h2>
            </div>
        </div>

        <div class="config-item">
            <div>
                <strong>Sair da conta</strong>
                <span>Encerra a sessão atual neste navegador.</span>
            </div>
            <form action="/logout" method="POST" class="acoes">
                <button type="submit" class="painel-btn-perigo">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Sair
                </button>
            </form>
        </div>
    </section>
</main>

<%- include('partials/scripts', { scripts: [] }) %>
</body>
</html>
