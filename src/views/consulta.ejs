<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rural Tech - Consulta</title>

    <!-- Removido o ../ dos estilos -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/consulta.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

    <!-- MENU LATERAL -->
    <%- include('partials/menu') %>
    
    <!-- CABEÇALHO -->
    <header>

        <button class="menu-btn" id="menuBtn">
            <i class="fa-solid fa-bars"></i>
        </button>

        <!-- Removido o ../ da imagem -->
        <img src="/img/logotcc.png" alt="Logo Rural Tech">

        <h2>Rural Tech</h2>

    </header>

    <main>
        <section class="cabecalho-pagina">
            <span>CONSULTA</span>
            <h1>Consulta de informações</h1>
            <p>
                Consulte rapidamente as informações cadastradas no sistema.
            </p>
        </section>

        <section class="filtros">
            <h2>
                <i class="fa-solid fa-filter"></i>
                Filtros de pesquisa
            </h2>
            <div class="campo">

                <label for="categoria">Categoria</label>

                <select id="categoria">
                    <option value="">Selecione uma categoria</option>
                    <option value="produtos">Produtos</option>
                    <option value="producao">Produção</option>
                    <option value="vendas">Vendas</option>
                    <option value="gastos">Gastos</option>
                </select>

            </div>

            <div class="campo">

                <label for="tipoInformacao">Tipo de informação</label>

                <select id="tipoInformacao">
                    <option value="">Selecione o tipo</option>
                    <option value="nome">Nome</option>
                    <option value="data">Data</option>
                    <option value="quantidade">Quantidade</option>
                    <option value="valor">Valor</option>
                </select>

            </div>

            <div class="campo">

                <label for="busca">Buscar</label>

                <div class="campo-busca">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="busca" placeholder="Digite para buscar">
                </div>

            </div>

            <button type="button" class="btn-pesquisar" id="btnPesquisar">
                <i class="fa-solid fa-magnifying-glass"></i>
                Pesquisar
            </button>

        </section>

        <section class="resultados">

            <div class="titulo-resultados">
                <h2>
                    <i class="fa-solid fa-chart-column"></i>
                    Resultados
                </h2>
            </div>

            <div class="area-resultados" id="areaResultados">
                <div class="icone-resultado">
                    <i class="fa-solid fa-file-lines"></i>
                </div>
                <h3>Nenhum resultado encontrado</h3>
                <p>
                    Utilize os filtros acima para encontrar as informações desejadas.
                </p>
            </div>

        </section>

    </main>

    <!-- Removido o ../ dos scripts -->
    <script src="/js/menu_lateral.js"></script>
    <script src="/js/consulta.js"></script>

</body>

</html>