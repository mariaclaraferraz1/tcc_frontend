<%- include('partials/head', { titulo: titulo, css: [] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<%
    const dadosForm = dados || {};
%>

<main class="painel-main">
    <%- include('partials/mensagens') %>

    <section class="painel-hero">
        <div>
            <span class="eyebrow">
                <i class="fa-solid fa-money-bill-wave"></i>
                Comercial
            </span>
            <h1>Controle de gastos</h1>
            <p>Registre as despesas da propriedade e acompanhe os custos por categoria e período.</p>
        </div>

        <div class="painel-hero-acoes">
            <a href="/lucros" class="painel-btn-secundario">
                <i class="fa-solid fa-chart-line"></i>
                Ver lucros
            </a>
            <a href="/comercial" class="painel-btn-secundario">
                <i class="fa-solid fa-arrow-left"></i>
                Comercial
            </a>
        </div>
    </section>

    <section class="painel-resumo">
        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-money-bill-wave"></i></div>
            <div class="painel-card-info">
                <span>Total de gastos</span>
                <strong><%= formatarMoeda(resumo.total_valor || 0) %></strong>
                <small>Nos filtros atuais</small>
            </div>
        </div>

        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-receipt"></i></div>
            <div class="painel-card-info">
                <span>Registros</span>
                <strong><%= formatarNumero(resumo.total_registros || 0, 0) %></strong>
                <small>Gastos cadastrados</small>
            </div>
        </div>

        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-calculator"></i></div>
            <div class="painel-card-info">
                <span>Média por gasto</span>
                <strong><%= formatarMoeda(resumo.media_valor || 0) %></strong>
                <small>Valor médio dos registros</small>
            </div>
        </div>
    </section>

    <form action="/controle-de-gastos" method="POST" class="painel-form" id="gastoForm">
        <div class="painel-form-titulo">
            <i class="fa-solid fa-plus"></i>
            <div>
                <h2>Registrar gasto</h2>
                <p>Informe a despesa, a data e a classificação para o controle financeiro.</p>
            </div>
        </div>

        <div class="form-grade">
            <div class="form-grupo largo">
                <label for="descricao">Descrição do gasto *</label>
                <input type="text" id="descricao" name="descricao" maxlength="255" required value="<%= dadosForm.descricao || '' %>" placeholder="Ex: Compra de matéria-prima">
            </div>

            <div class="form-grupo">
                <label for="categoria">Categoria *</label>
                <input type="text" id="categoria" name="categoria" maxlength="100" list="categorias-gasto" required value="<%= dadosForm.categoria || '' %>" placeholder="Ex: Equipamentos">
                <datalist id="categorias-gasto">
                    <% categorias.forEach(function (categoria) { %>
                        <option value="<%= categoria %>"></option>
                    <% }); %>
                </datalist>
            </div>

            <div class="form-grupo">
                <label for="classificacao">Classificação *</label>
                <select id="classificacao" name="classificacao" required>
                    <option value="">Selecione</option>
                    <% classificacoes.forEach(function (classificacao) { %>
                        <option value="<%= classificacao %>" <%= dadosForm.classificacao === classificacao ? 'selected' : '' %>><%= classificacao %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-grupo">
                <label for="dataGasto">Data do gasto *</label>
                <input type="date" id="dataGasto" name="dataGasto" required value="<%= dadosForm.dataGasto || hoje %>">
            </div>

            <div class="form-grupo">
                <label for="valor">Valor (R$) *</label>
                <input type="number" id="valor" name="valor" min="0.01" step="0.01" required value="<%= dadosForm.valor || '' %>" placeholder="0,00">
            </div>

            <div class="form-grupo">
                <label for="formaPagamento">Forma de pagamento</label>
                <select id="formaPagamento" name="formaPagamento">
                    <option value="">Selecione</option>
                    <% formasPagamento.forEach(function (forma) { %>
                        <option value="<%= forma %>" <%= dadosForm.formaPagamento === forma ? 'selected' : '' %>><%= forma %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-grupo">
                <label for="fornecedor">Fornecedor <span class="opcional">(opcional)</span></label>
                <input type="text" id="fornecedor" name="fornecedor" maxlength="150" value="<%= dadosForm.fornecedor || '' %>" placeholder="Nome da empresa ou prestador">
            </div>

            <div class="form-grupo">
                <label for="arquivo-comprovante">Comprovante <span class="opcional">(imagem ou PDF)</span></label>
                <input type="file" id="arquivo-comprovante" accept="image/png, image/jpeg, image/webp, image/gif, application/pdf">
                <small>Arquivo de até 2 MB.</small>
            </div>

            <div class="form-grupo">
                <label for="comprovanteLink">Ou informe um link do comprovante</label>
                <input type="url" id="comprovanteLink" name="comprovanteLink" maxlength="1000" value="<%= dadosForm.comprovanteLink || '' %>" placeholder="https://...">
            </div>

            <div class="form-grupo largo">
                <input type="hidden" name="comprovante" id="comprovante-data" value="">
                <label for="observacao">Observações <span class="opcional">(opcional)</span></label>
                <textarea id="observacao" name="observacao" maxlength="1000" placeholder="Informações adicionais importantes..."><%= dadosForm.observacao || '' %></textarea>
            </div>
        </div>

        <div class="form-acoes">
            <button type="reset" class="painel-btn-secundario">
                <i class="fa-solid fa-eraser"></i>
                Limpar campos
            </button>
            <button type="submit" class="painel-btn btn-submit">
                <i class="fa-solid fa-check"></i>
                Salvar gasto
            </button>
        </div>
    </form>

    <section class="painel-secao">
        <div class="painel-secao-topo">
            <div>
                <span class="painel-secao-label">
                    <i class="fa-solid fa-filter"></i>
                    Histórico
                </span>
                <h2>Gastos registrados</h2>
            </div>
        </div>

        <form action="/controle-de-gastos" method="GET" class="painel-filtros">
            <div class="painel-filtros-titulo">
                <i class="fa-solid fa-filter"></i>
                Filtrar gastos
            </div>

            <div class="painel-filtros-grade">
                <div class="form-grupo">
                    <label for="filtro-q">Buscar</label>
                    <input type="search" id="filtro-q" name="q" value="<%= filtros.q || '' %>" placeholder="Descrição, fornecedor, categoria...">
                </div>

                <div class="form-grupo">
                    <label for="filtro-categoria">Categoria</label>
                    <select id="filtro-categoria" name="categoria">
                        <option value="">Todas as categorias</option>
                        <% categorias.forEach(function (categoria) { %>
                            <option value="<%= categoria %>" <%= filtros.categoria === categoria ? 'selected' : '' %>><%= categoria %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-grupo">
                    <label for="filtro-classificacao">Classificação</label>
                    <select id="filtro-classificacao" name="classificacao">
                        <option value="">Todas as classificações</option>
                        <% classificacoes.forEach(function (classificacao) { %>
                            <option value="<%= classificacao %>" <%= filtros.classificacao === classificacao ? 'selected' : '' %>><%= classificacao %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-grupo">
                    <label for="filtro-inicio">De</label>
                    <input type="date" id="filtro-inicio" name="inicio" value="<%= filtros.inicio || '' %>">
                </div>

                <div class="form-grupo">
                    <label for="filtro-fim">Até</label>
                    <input type="date" id="filtro-fim" name="fim" value="<%= filtros.fim || '' %>">
                </div>
            </div>

            <div class="painel-filtros-acoes">
                <button type="submit" class="painel-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Filtrar
                </button>
                <a href="/controle-de-gastos" class="link-limpar">
                    <i class="fa-solid fa-xmark"></i>
                    Limpar filtros
                </a>
            </div>
        </form>

        <% if (gastos.length === 0) { %>
            <div class="painel-vazio">
                <i class="fa-solid fa-receipt"></i>
                <h3>Nenhum gasto encontrado</h3>
                <p>
                    <% if (filtros.q || filtros.inicio || filtros.fim || filtros.categoria || filtros.classificacao) { %>
                        Não há gastos para os filtros informados. Ajuste os critérios ou limpe os filtros.
                    <% } else { %>
                        Registre o primeiro gasto no formulário acima para acompanhar os custos da propriedade.
                    <% } %>
                </p>
            </div>
        <% } else { %>
            <div class="painel-tabela-wrapper">
                <table class="painel-tabela">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Descrição</th>
                            <th>Categoria</th>
                            <th>Classificação</th>
                            <th>Fornecedor</th>
                            <th>Pagamento</th>
                            <th>Valor</th>
                            <th>Comprovante</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% gastos.forEach(function (gasto) { %>
                            <tr>
                                <td><%= formatarData(gasto.data_gasto) %></td>
                                <td class="quebra">
                                    <%= gasto.descricao %>
                                    <% if (gasto.observacao) { %>
                                        <br><small><%= gasto.observacao %></small>
                                    <% } %>
                                </td>
                                <td><%= gasto.categoria || '-' %></td>
                                <td><%= gasto.classificacao || '-' %></td>
                                <td><%= gasto.fornecedor || '-' %></td>
                                <td><%= gasto.forma_pagamento || '-' %></td>
                                <td class="numero"><strong><%= formatarMoeda(gasto.valor) %></strong></td>
                                <td>
                                    <% if (gasto.comprovante) { %>
                                        <a href="<%= gasto.comprovante %>" target="_blank" rel="noopener noreferrer" class="link-limpar">
                                            <i class="fa-solid fa-paperclip"></i>
                                            Ver
                                        </a>
                                    <% } else { %>
                                        -
                                    <% } %>
                                </td>
                                <td>
                                    <div class="acoes">
                                        <form action="/controle-de-gastos/<%= gasto.id_gasto %>/excluir" method="POST" data-confirmar="Excluir o gasto &quot;<%= gasto.descricao %>&quot;?">
                                            <button type="submit" class="painel-btn-perigo painel-btn-mini">
                                                <i class="fa-solid fa-trash"></i>
                                                Excluir
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>
</main>

<%- include('partials/scripts', { scripts: ['/js/gastos.js'] }) %>
</body>
</html>
