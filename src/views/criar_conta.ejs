<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rural Tech | <%= titulo %></title>
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>
    <% const valores = typeof dados !== "undefined" && dados ? dados : {}; %>

    <main class="login-container">
        <div class="login-box">
            <div class="login-header">
                <span class="login-label">RURAL TECH</span>
                <h1>Criar conta</h1>
                <p>Cadastre-se para começar a organizar sua produção</p>
            </div>

            <form action="/criar-conta" method="POST">
                <div class="input-group">
                    <label for="nome">Nome completo</label>
                    <input
                        type="text"
                        id="nome"
                        name="nome"
                        value="<%= valores.nome || '' %>"
                        placeholder="Digite seu nome completo"
                        maxlength="100"
                        autocomplete="name"
                        required
                    >
                </div>

                <div class="input-group">
                    <label for="email">E-mail</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= valores.email || '' %>"
                        placeholder="Digite seu e-mail"
                        maxlength="150"
                        autocomplete="email"
                        required
                    >
                </div>

                <div class="input-group">
                    <label for="telefone">Telefone <span>(opcional)</span></label>
                    <input
                        type="tel"
                        id="telefone"
                        name="telefone"
                        value="<%= valores.telefone || '' %>"
                        placeholder="(00) 00000-0000"
                        maxlength="30"
                        autocomplete="tel"
                    >
                </div>

                <div class="input-group">
                    <label for="senha">Senha</label>
                    <input
                        type="password"
                        id="senha"
                        name="senha"
                        placeholder="Mínimo de 8 caracteres com letras e números"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >
                </div>

                <div class="input-group">
                    <label for="confirmarSenha">Confirmar senha</label>
                    <input
                        type="password"
                        id="confirmarSenha"
                        name="confirmarSenha"
                        placeholder="Digite a senha novamente"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >
                </div>

                <button type="submit">
                    <span>Cadastrar</span>
                    <span class="button-arrow">→</span>
                </button>

                <% if (erro || mensagem) { %>
                    <p id="mensagem" class="<%= mensagem && mensagem.tipo === 'sucesso' ? 'sucesso' : '' %>">
                        <%= erro || mensagem.texto %>
                    </p>
                <% } else { %>
                    <p id="mensagem"></p>
                <% } %>
            </form>

            <div class="register-text">
                <span>Já possui uma conta?</span>
                <a href="/login">
                    Faça login
                    <span class="register-arrow">→</span>
                </a>
            </div>
        </div>
    </main>
</body>

</html>
