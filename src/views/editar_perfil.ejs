<%- include('partials/head', { titulo: titulo, css: [] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<main class="painel-main">
    <%- include('partials/mensagens') %>

    <section class="painel-hero">
        <div>
            <span class="eyebrow">
                <i class="fa-solid fa-user-pen"></i>
                Conta
            </span>
            <h1>Editar perfil</h1>
            <p>Atualize os dados cadastrais da sua conta.</p>
        </div>

        <div class="painel-hero-acoes">
            <a href="/configuracoes" class="painel-btn-secundario">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar para configurações
            </a>
        </div>
    </section>

    <form action="/editar-perfil" method="POST" class="painel-form">
        <div class="painel-form-titulo">
            <i class="fa-solid fa-address-card"></i>
            <div>
                <h2>Dados pessoais</h2>
                <p>O e-mail é usado para entrar no sistema e deve ser único.</p>
            </div>
        </div>

        <div class="form-grade">
            <div class="form-grupo largo">
                <label for="nome">Nome completo *</label>
                <input type="text" id="nome" name="nome" maxlength="100" required value="<%= dados.nome || '' %>" placeholder="Seu nome completo">
            </div>

            <div class="form-grupo">
                <label for="email">E-mail *</label>
                <input type="email" id="email" name="email" maxlength="150" required value="<%= dados.email || '' %>" placeholder="voce@exemplo.com">
            </div>

            <div class="form-grupo">
                <label for="telefone">Telefone <span class="opcional">(opcional)</span></label>
                <input type="tel" id="telefone" name="telefone" maxlength="30" value="<%= dados.telefone || '' %>" placeholder="(00) 00000-0000">
            </div>
        </div>

        <div class="form-acoes">
            <a href="/configuracoes" class="painel-btn-secundario">
                <i class="fa-solid fa-xmark"></i>
                Cancelar
            </a>
            <button type="submit" class="painel-btn">
                <i class="fa-solid fa-check"></i>
                Salvar perfil
            </button>
        </div>
    </form>
</main>

<%- include('partials/scripts', { scripts: [] }) %>
</body>
</html>
