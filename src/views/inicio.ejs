<!DOCTYPE html>

<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rural Tech - Início</title>

    <link rel="stylesheet" href="/css/inicio.css" />
    <link rel="stylesheet" href="/css/style.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <div id="menu-container"></div>

    <header>
      <button class="menu-btn" id="menuBtn">
        <i class="fa-solid fa-bars"></i>
      </button>

      <img src="/img/logotcc.png" alt="Logo Rural Tech" />

      <h2>Rural Tech</h2>
    </header>

    <main>
      <section class="boas-vindas">
        <span>Olá! 👋</span>

        <h1>Bem-vindo ao Rural Tech</h1>

        <p>Acompanhe sua produção de forma simples e organizada.</p>
      </section>

      <section>
        <h2 class="titulo-secao">Resumo</h2>

        <div class="cards">
          <div class="card">
            <div class="icone">
              <i class="fa-solid fa-seedling"></i>
            </div>

            <div>
              <p>Produção</p>
              <strong>0 kg</strong>
            </div>
          </div>

          <div class="card">
            <div class="icone">
              <i class="fa-solid fa-box"></i>
            </div>

            <div>
              <p>Produtos</p>
              <strong>0</strong>
            </div>
          </div>

          <div class="card">
            <div class="icone">
              <i class="fa-solid fa-money-bill-trend-up"></i>
            </div>

            <div>
              <p>Vendas</p>
              <strong>R$ 0,00</strong>
            </div>
          </div>

          <div class="card">
            <div class="icone">
              <i class="fa-solid fa-receipt"></i>
            </div>

            <div>
              <p>Gastos</p>
              <strong>R$ 0,00</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="secao">
        <h2 class="titulo-secao">Resumo financeiro</h2>

        <div class="financeiro">
          <div class="financeiro-item">
            <span>Vendas</span>
            <strong>R$ 0,00</strong>
          </div>

          <div class="financeiro-item">
            <span>Gastos</span>
            <strong>R$ 0,00</strong>
          </div>

          <div class="financeiro-item">
            <span>Lucro</span>
            <strong>R$ 0,00</strong>
          </div>
        </div>
      </section>

      <section class="secao">
        <h2 class="titulo-secao">Acesso rápido</h2>

        <div class="atalhos">
          <a href="/produtos">
            <i class="fa-solid fa-box"></i>
            <span>Produtos</span>
          </a>

          <a href="/producao">
            <i class="fa-solid fa-seedling"></i>
            <span>Produção</span>
          </a>

          <a href="/vendas">
            <i class="fa-solid fa-cart-shopping"></i>
            <span>Vendas</span>
          </a>

          <a href="#">
            <i class="fa-solid fa-receipt"></i>
            <span>Gastos</span>
          </a>
        </div>
      </section>
    </main>

    <script src="/js/menu_lateral.js"></script>
  </body>
</html>
