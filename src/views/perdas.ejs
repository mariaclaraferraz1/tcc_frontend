<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rural Tech - Registrar Perda</title>

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/dados_perda.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <%- include('partials/menu') %>

    <!-- CABEÇALHO -->
    <header>
      <button class="menu-btn" id="menuBtn">
        <i class="fa-solid fa-bars"></i>
      </button>

      <!-- Removido o ../ da imagem -->
      <img src="/img/logotcc.png" alt="Logo Rural Tech" />

      <h2>Rural Tech</h2>
    </header>

    <!-- CONTEÚDO -->
    <main>
      <section class="cabecalho-perda">
        <h1>
          <i class="fa-solid fa-arrow-left"></i>
          Registrar Perda
        </h1>

        <p>Informe os dados da perda ocorrida na produção.</p>
      </section>

      <!-- CARD -->
      <section class="card-perda">
        <!-- TÍTULO -->
        <div class="titulo-perda">
          <i class="fa-solid fa-clipboard-list"></i>

          <h2>Dados da Perda</h2>
        </div>

        <!-- DICA -->
        <div class="dica">
          <i class="fa-solid fa-lightbulb"></i>

          <div>
            <strong>Dica importante</strong>

            <p>
              Registrar as perdas ajuda a identificar problemas na produção e
              melhora o planejamento da sua propriedade.
            </p>
          </div>
        </div>

        <!-- PRODUTO / DATA -->
        <div class="linha">
          <div class="campo produto">
            <label>Produto</label>

            <select id="produto">
              <option value="">Selecione o produto</option>

              <option value="milho">Milho</option>

              <option value="soja">Soja</option>

              <option value="cafe">Café</option>

              <option value="feijao">Feijão</option>
            </select>
          </div>

          <div class="campo">
            <label>Data da perda</label>

            <input type="date" id="data-perda" />
          </div>
        </div>

        <!-- QUANTIDADE / UNIDADE -->
        <div class="linha">
          <div class="campo">
            <label>Quantidade perdida</label>

            <input
              type="number"
              id="quantidade"
              placeholder="Ex: 50"
              min="0"
              step="0.01"
            />
          </div>

          <div class="campo unidade">
            <label>Unidade</label>

            <select id="unidade">
              <option value="kg">KG</option>

              <option value="sacas">Sacas</option>

              <option value="toneladas">Toneladas</option>
            </select>
          </div>
        </div>

        <!-- MOTIVO -->
        <div class="campo motivo">
          <label>Motivo da perda</label>

          <select id="motivo">
            <option value="">Selecione o motivo da perda</option>

            <option value="pragas">Pragas</option>

            <option value="doencas">Doenças</option>

            <option value="clima">Condições climáticas</option>

            <option value="seca">Seca</option>

            <option value="chuva">Excesso de chuva</option>

            <option value="geada">Geada</option>

            <option value="armazenamento">Problemas no armazenamento</option>

            <option value="transporte">Problemas no transporte</option>

            <option value="outros">Outros</option>
          </select>
        </div>

        <!-- LOCAL -->
        <div class="campo">
          <label>Local da perda</label>

          <input
            type="text"
            id="local-perda"
            placeholder="Ex: Talhão 01, galpão, armazenamento..."
          />
        </div>

        <!-- VALOR ESTIMADO -->
        <div class="campo">
          <label>Valor estimado da perda (R$)</label>

          <input
            type="number"
            id="valor-perda"
            placeholder="Ex: 500,00"
            min="0"
            step="0.01"
          />
        </div>

        <!-- OBSERVAÇÕES -->
        <div class="campo observacoes">
          <label> Observações <span>(opcional)</span> </label>

          <textarea
            id="observacoes"
            placeholder="Ex: Informações adicionais sobre a perda..."
          ></textarea>
        </div>

        <!-- BOTÕES -->
        <div class="botoes">
          <button type="button" class="btn-cancelar" id="btnCancelar">
            <i class="fa-solid fa-xmark"></i>

            Cancelar
          </button>

          <button type="button" class="btn-salvar" id="btnSalvar">
            <i class="fa-solid fa-check"></i>

            Salvar perda
          </button>
        </div>
      </section>
    </main>

    <script src="/js/menu_lateral.js"></script>

    <script src="/js/dados_perda.js"></script>
  </body>
</html>
