<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rural Tech - Perdas</title>

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/dados_perda.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <%- include('partials/menu') %>

    <!-- CABEÇALHO -->
    <header>
      <button class="menu-btn" id="menuBtn">
        <i class="fa-solid fa-bars"></i>
      </button>

      <img src="/img/logotcc.png" alt="Logo Rural Tech" />

      <h2>Rural Tech</h2>
    </header>

    <!-- CONTEÚDO -->
    <main>
      <section class="cabecalho-perda">
        <h1>
          <a href="/comercial" aria-label="Voltar para o Comercial" class="btn-voltar">
            <i class="fa-solid fa-arrow-left"></i>
          </a>
          Perdas
        </h1>

        <p>Perdas cadastradas antes de registrar novas perdas.</p>
      </section>

      <% if (typeof mensagem !== 'undefined' && mensagem) { %>
        <p class="mensagem-sucesso"><i class="fa-solid fa-circle-check"></i> <%= mensagem %></p>
      <% } %>

      <section class="card-perda">
        <div class="titulo-perda">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <h2>Perdas cadastradas</h2>
        </div>

        <div class="resumo-total">
          <span>Valor estimado total das perdas</span>
          <strong><%= Number(total || 0).toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %></strong>
        </div>

        <div class="tabela-perdas">
          <table>
            <thead>
              <tr>
                <th>Produto</th>
                <th>Quantidade</th>
                <th>Motivo</th>
                <th>Valor estimado</th>
                <th>Data</th>
              </tr>
            </thead>
            <tbody>
              <% if (!perdas || perdas.length === 0) { %>
                <tr>
                  <td colspan="5">Nenhuma perda cadastrada.</td>
                </tr>
              <% } else { %>
                <% perdas.forEach(function(perda) { %>
                  <tr>
                    <td><%= perda.produto %></td>
                    <td><%= Number(perda.quantidade).toLocaleString("pt-BR") %> <%= perda.unidade %></td>
                    <td><%= perda.motivo %></td>
                    <td><%= Number(perda.valor_estimado).toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %></td>
                    <td><%= new Date(perda.data_perda + "T12:00:00").toLocaleDateString("pt-BR") %></td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="botoes">
          <a href="/perdas/nova" class="btn-salvar btn-link">
            <i class="fa-solid fa-plus"></i>
            Registrar perda
          </a>
        </div>
      </section>
    </main>

    <script src="/js/menu_lateral.js"></script>
  </body>
</html>
