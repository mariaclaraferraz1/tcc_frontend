<%- include('partials/head', { titulo: titulo, css: [] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<%
    const dadosForm = dados || {};
    const editando = Boolean(dadosForm.id);
    const listaProdutos = produtos || [];
    const culturas = Array.from(new Set(listaProdutos.map(function (produto) {
        return produto.nome;
    }))).sort(function (a, b) {
        return String(a).localeCompare(String(b), "pt-BR");
    });

    function somarDiasPlantio(dataISO, dias) {
        const partes = String(dataISO).split("-").map(Number);
        const resultado = new Date(Date.UTC(partes[0], partes[1] - 1, partes[2] + dias));

        return [
            resultado.getUTCFullYear(),
            String(resultado.getUTCMonth() + 1).padStart(2, "0"),
            String(resultado.getUTCDate()).padStart(2, "0")
        ].join("-");
    }

    const produtoSelecionado = listaProdutos.find(function (produto) {
        return String(produto.id_produto) === String(dadosForm.idProduto || "");
    }) || null;
    const cicloInicial = produtoSelecionado && Number(produtoSelecionado.ciclo_dias) > 0
        ? Math.trunc(Number(produtoSelecionado.ciclo_dias))
        : null;
    const dataBaseInicial = dadosForm.dataPlantio || hoje;
    const previsaoInicial = cicloInicial && /^\d{4}-\d{2}-\d{2}$/.test(dataBaseInicial)
        ? formatarData(somarDiasPlantio(dataBaseInicial, cicloInicial))
        : "";
    const cicloTextoInicial = produtoSelecionado
        ? (cicloInicial ? cicloInicial + " dias" : "Sem ciclo cadastrado")
        : "";
%>

<main class="painel-main">
    <%- include('partials/mensagens') %>

    <section class="painel-hero">
        <div>
            <span class="eyebrow">
                <i class="fa-solid fa-wheat-awn"></i>
                Produção
            </span>
            <h1>Plantio</h1>
            <p>Acompanhe as culturas plantadas, a área utilizada e o status de desenvolvimento.</p>
        </div>

        <div class="painel-hero-acoes">
            <a href="/producao" class="painel-btn-secundario">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar para produção
            </a>
        </div>
    </section>

    <section class="painel-resumo">
        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-wheat-awn"></i></div>
            <div class="painel-card-info">
                <span>Plantios</span>
                <strong><%= formatarNumero(resumo.total_registros || 0, 0) %></strong>
                <small>Total cadastrado</small>
            </div>
        </div>

        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-seedling"></i></div>
            <div class="painel-card-info">
                <span>Em progresso</span>
                <strong><%= formatarNumero(resumo.em_progresso || 0, 0) %></strong>
                <small>Ainda não colhidos</small>
            </div>
        </div>

        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <div class="painel-card-info">
                <span>Prontos para colheita</span>
                <strong><%= formatarNumero(resumo.prontos || 0, 0) %></strong>
                <small>Previsão já atingida</small>
            </div>
        </div>

        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-check"></i></div>
            <div class="painel-card-info">
                <span>Colhidos</span>
                <strong><%= formatarNumero(resumo.colhidos || 0, 0) %></strong>
                <small>Colheita registrada</small>
            </div>
        </div>
    </section>

    <% if (listaProdutos.length === 0) { %>
        <div class="painel-alerta aviso" role="alert">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>
                Nenhum produto ativo cadastrado no estoque. Cadastre um produto com cultura, variedade e ciclo
                antes de registrar o plantio.
                <a href="/cadastro-produto">Cadastrar produto</a>
            </span>
        </div>
    <% } %>

    <form action="<%= editando ? '/plantio/' + dadosForm.id + '/editar' : '/plantio' %>" method="POST" class="painel-form" id="form-plantio">
        <div class="painel-form-titulo">
            <i class="fa-solid <%= editando ? 'fa-pen' : 'fa-plus' %>"></i>
            <div>
                <h2><%= editando ? 'Editar plantio' : 'Registrar plantio' %></h2>
                <p>
                    <%= editando
                        ? 'Altere os dados do plantio. A previsão de colheita é recalculada ao salvar.'
                        : 'Selecione um produto do estoque, informe a área e a data do plantio. Ele começará em progresso.' %>
                </p>
            </div>
        </div>

        <div class="painel-dica">
            <i class="fa-solid fa-lightbulb"></i>
            <div>
                <strong>Cultura, variedade e ciclo vêm do estoque</strong>
                <p>
                    Só é possível plantar produtos já cadastrados. A previsão de colheita é uma estimativa
                    calculada com a data do plantio mais o ciclo do produto, quando o ciclo estiver cadastrado.
                    O plantio fica em progresso e só passa para "Colhido" quando você informar a data real
                    da colheita.
                </p>
            </div>
        </div>

        <div class="form-grade">
            <div class="form-grupo">
                <label for="cultura-plantio">Cultura *</label>
                <select id="cultura-plantio" <%= listaProdutos.length === 0 ? 'disabled' : '' %>>
                    <option value="">Selecione a cultura</option>
                    <% culturas.forEach(function (cultura) { %>
                        <option value="<%= cultura %>" <%= dadosForm.cultura === cultura ? 'selected' : '' %>><%= cultura %></option>
                    <% }); %>
                </select>
                <small>Culturas disponíveis nos produtos ativos do seu estoque.</small>
            </div>

            <div class="form-grupo">
                <label for="variedade-plantio">Variedade *</label>
                <select id="variedade-plantio" name="idProduto" required <%= listaProdutos.length === 0 ? 'disabled' : '' %>>
                    <option value="">Selecione a cultura primeiro</option>
                    <% listaProdutos.forEach(function (produto) { %>
                        <option
                            value="<%= produto.id_produto %>"
                            data-cultura="<%= produto.nome %>"
                            data-variedade="<%= produto.variedade || '' %>"
                            data-ciclo="<%= produto.ciclo_dias !== null && produto.ciclo_dias !== undefined ? produto.ciclo_dias : '' %>"
                            <%= String(dadosForm.idProduto || '') === String(produto.id_produto) ? 'selected' : '' %>
                        >
                            <%= produto.variedade || 'Variedade padrão' %> — estoque: <%= formatarQuantidade(produto.estoque) %> <%= produto.unidade || 'kg' %>
                        </option>
                    <% }); %>
                </select>
                <small>A variedade é vinculada ao produto escolhido no estoque.</small>
            </div>

            <div class="form-grupo">
                <label for="area">Área / talhão *</label>
                <input type="text" id="area" name="area" maxlength="150" required value="<%= dadosForm.area || '' %>" placeholder="Ex: Talhão 02 — 3 hectares">
            </div>

            <div class="form-grupo">
                <label for="dataPlantio">Data do plantio *</label>
                <input type="date" id="dataPlantio" name="dataPlantio" required value="<%= dadosForm.dataPlantio || hoje %>">
            </div>

            <div class="form-grupo">
                <label for="<%= editando ? 'status' : 'status-visual' %>">Status *</label>
                <% if (editando) { %>
                    <select id="status" name="status" required>
                        <% statusOpcoes.forEach(function (opcao) { %>
                            <option value="<%= opcao.valor %>" <%= (dadosForm.status || 'em_progresso') === opcao.valor ? 'selected' : '' %>><%= opcao.rotulo %></option>
                        <% }); %>
                    </select>
                    <small>O plantio fica em progresso até você registrar a colheita.</small>
                <% } else { %>
                    <input type="text" id="status-visual" class="painel-campo-calculado" readonly value="Em progresso">
                    <input type="hidden" id="status" name="status" value="em_progresso">
                    <small>Todo plantio começa em progresso. Ao colher, use a ação "Colher" na lista.</small>
                <% } %>
            </div>

            <div class="form-grupo" id="grupo-data-colheita" <%= (dadosForm.status || 'em_progresso') === 'colhido' ? '' : 'hidden' %>>
                <label for="dataColheita">Data da colheita *</label>
                <input type="date" id="dataColheita" name="dataColheita" value="<%= dadosForm.dataColheita || '' %>">
                <small>Informe a data real da colheita. Ela deve ser posterior à data do plantio.</small>
            </div>

            <div class="form-grupo">
                <label for="ciclo-plantio">Ciclo do produto</label>
                <input type="text" id="ciclo-plantio" class="painel-campo-calculado" readonly value="<%= cicloTextoInicial %>">
                <small>Dias entre o plantio e a colheita, conforme o cadastro do produto.</small>
            </div>

            <div class="form-grupo largo">
                <label for="previsao-colheita">Previsão de colheita</label>
                <input type="text" id="previsao-colheita" class="painel-campo-calculado" readonly value="<%= previsaoInicial %>">
                <small id="aviso-ciclo">
                    <% if (produtoSelecionado && !cicloInicial) { %>
                        Este produto não possui ciclo cadastrado; não é possível estimar a colheita.
                    <% } else if (!produtoSelecionado) { %>
                        Selecione um produto com ciclo cadastrado para gerar a previsão.
                    <% } else { %>
                        Previsão automática (data do plantio + ciclo). É apenas uma estimativa, não uma garantia de colheita.
                    <% } %>
                </small>
            </div>

            <div class="form-grupo largo">
                <label for="observacoes">Observações <span class="opcional">(opcional)</span></label>
                <textarea id="observacoes" name="observacoes" maxlength="1000" placeholder="Informações sobre o plantio..."><%= dadosForm.observacoes || '' %></textarea>
            </div>
        </div>

        <div class="form-acoes">
            <a href="/plantio" class="painel-btn-secundario">
                <i class="fa-solid fa-xmark"></i>
                <%= editando ? 'Cancelar edição' : 'Cancelar' %>
            </a>
            <button type="submit" class="painel-btn" <%= listaProdutos.length === 0 ? 'disabled' : '' %>>
                <i class="fa-solid fa-check"></i>
                <%= editando ? 'Salvar alterações' : 'Salvar plantio' %>
            </button>
        </div>
    </form>

    <section class="painel-secao">
        <div class="painel-secao-topo">
            <div>
                <span class="painel-secao-label">
                    <i class="fa-solid fa-filter"></i>
                    Histórico
                </span>
                <h2>Plantios registrados</h2>
            </div>
        </div>

        <form action="/plantio" method="GET" class="painel-filtros">
            <div class="painel-filtros-titulo">
                <i class="fa-solid fa-filter"></i>
                Filtrar plantios
            </div>

            <div class="painel-filtros-grade">
                <div class="form-grupo">
                    <label for="filtro-q">Buscar</label>
                    <input type="search" id="filtro-q" name="q" value="<%= filtros.q || '' %>" placeholder="Cultura, variedade, área ou observação...">
                </div>

                <div class="form-grupo">
                    <label for="filtro-status">Status</label>
                    <select id="filtro-status" name="status">
                        <option value="">Todos os status</option>
                        <% statusOpcoes.forEach(function (opcao) { %>
                            <option value="<%= opcao.valor %>" <%= filtros.status === opcao.valor ? 'selected' : '' %>><%= opcao.rotulo %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-grupo">
                    <label for="filtro-inicio">De</label>
                    <input type="date" id="filtro-inicio" name="inicio" value="<%= filtros.inicio || '' %>">
                </div>

                <div class="form-grupo">
                    <label for="filtro-fim">Até</label>
                    <input type="date" id="filtro-fim" name="fim" value="<%= filtros.fim || '' %>">
                </div>
            </div>

            <div class="painel-filtros-acoes">
                <button type="submit" class="painel-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Filtrar
                </button>
                <a href="/plantio" class="link-limpar">
                    <i class="fa-solid fa-xmark"></i>
                    Limpar filtros
                </a>
            </div>
        </form>

        <% if (plantios.length === 0) { %>
            <div class="painel-vazio">
                <i class="fa-solid fa-wheat-awn"></i>
                <h3>Nenhum plantio encontrado</h3>
                <p>
                    <% if (filtros.q || filtros.inicio || filtros.fim || filtros.status) { %>
                        Não há plantios para os filtros informados. Ajuste os critérios ou limpe os filtros.
                    <% } else { %>
                        Registre o primeiro plantio no formulário acima.
                    <% } %>
                </p>
            </div>
        <% } else { %>
            <div class="painel-tabela-wrapper">
                <table class="painel-tabela">
                    <thead>
                        <tr>
                            <th>Cultura</th>
                            <th>Variedade</th>
                            <th>Área / Talhão</th>
                            <th>Data do plantio</th>
                            <th>Previsão de colheita</th>
                            <th>Colheita realizada</th>
                            <th>Status</th>
                            <th>Observações</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% plantios.forEach(function (plantio) { %>
                            <tr>
                                <td><%= plantio.cultura %></td>
                                <td><%= plantio.variedade || '—' %></td>
                                <td><%= plantio.area %></td>
                                <td><%= formatarData(plantio.data_plantio) %></td>
                                <td>
                                    <% if (plantio.data_colheita_estimada) { %>
                                        <%= formatarData(plantio.data_colheita_estimada) %>
                                        <br>
                                        <small>previsão (<%= plantio.ciclo_dias %> dias)</small>
                                    <% } else { %>
                                        <small>Sem dados de ciclo</small>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (plantio.data_colheita) { %>
                                        <%= formatarData(plantio.data_colheita) %>
                                    <% } else { %>
                                        <small>—</small>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge <%= plantio.status === 'colhido' ? 'badge-sucesso' : 'badge-alerta' %>">
                                        <%= rotuloStatusPlantio(plantio.status) %>
                                    </span>
                                </td>
                                <td class="observacao"><%= plantio.observacoes || '-' %></td>
                                <td>
                                    <div class="acoes">
                                        <% if (plantio.status !== 'colhido') { %>
                                            <a href="/plantio?editar=<%= plantio.id_plantio %>&colher=1" class="painel-btn painel-btn-mini">
                                                <i class="fa-solid fa-seedling"></i>
                                                Colher
                                            </a>
                                        <% } %>
                                        <a href="/plantio?editar=<%= plantio.id_plantio %>" class="painel-btn-secundario painel-btn-mini">
                                            <i class="fa-solid fa-pen"></i>
                                            Editar
                                        </a>
                                        <form action="/plantio/<%= plantio.id_plantio %>/excluir" method="POST" data-confirmar="Excluir este plantio?">
                                            <button type="submit" class="painel-btn-perigo painel-btn-mini">
                                                <i class="fa-solid fa-trash"></i>
                                                Excluir
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>
</main>

<%- include('partials/scripts', { scripts: ['/js/plantio.js'] }) %>
</body>
</html>
