<%- include('partials/head', { titulo: titulo, css: ['/css/produtos.css'] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<%
    const info = estatisticas || {};
    const totalProdutos = Number(info.total_produtos || produtos.length || 0);
    const totalCategorias = Number(info.total_categorias || 0);
%>

<main class="produtos-main">
    <%- include('partials/mensagens') %>

    <section class="hero-produtos">
        <div class="hero-texto">
            <span class="eyebrow">
                <i class="fa-solid fa-leaf"></i>
                ESTOQUE E PRODUÇÃO
            </span>
            <h1>Seus produtos</h1>
            <p>Organize os produtos da propriedade e acompanhe o estoque de forma simples.</p>
        </div>

        <a href="/cadastro-produto" class="btn-cadastrar">
            <i class="fa-solid fa-plus"></i>
            <span>Novo produto</span>
        </a>
    </section>

    <section class="resumo-produtos">
        <div class="resumo-card">
            <div class="resumo-icone">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div class="resumo-info">
                <span>Produtos</span>
                <strong><%= formatarNumero(totalProdutos, 0) %></strong>
            </div>
            <i class="fa-solid fa-arrow-trend-up resumo-detalhe"></i>
        </div>

        <div class="resumo-card">
            <div class="resumo-icone">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div class="resumo-info">
                <span>Categorias</span>
                <strong><%= formatarNumero(totalCategorias, 0) %></strong>
            </div>
            <i class="fa-solid fa-leaf resumo-detalhe"></i>
        </div>

        <div class="resumo-card">
            <div class="resumo-icone">
                <i class="fa-solid fa-weight-hanging"></i>
            </div>
            <div class="resumo-info">
                <span>Estoque total</span>
                <strong><%= formatarQuantidade(info.total_estoque || 0) %></strong>
            </div>
            <i class="fa-solid fa-wheat-awn resumo-detalhe"></i>
        </div>
    </section>

    <section class="produtos-section">
        <div class="section-topo">
            <div>
                <span class="section-label">
                    <i class="fa-solid fa-seedling"></i>
                    SEU ESTOQUE
                </span>
                <h2>Produtos cadastrados</h2>
            </div>
            <span class="contador"><%= formatarNumero(produtos.length, 0) %> produto(s)</span>
        </div>

        <form action="/produtos" method="GET" class="painel-filtros">
            <div class="painel-filtros-titulo">
                <i class="fa-solid fa-filter"></i>
                Filtrar produtos
            </div>

            <div class="painel-filtros-grade">
                <div class="form-grupo">
                    <label for="filtro-q">Buscar</label>
                    <input type="search" id="filtro-q" name="q" value="<%= filtros.q || '' %>" placeholder="Nome, descrição ou categoria">
                </div>

                <div class="form-grupo">
                    <label for="filtro-categoria">Categoria</label>
                    <select id="filtro-categoria" name="categoria">
                        <option value="">Todas as categorias</option>
                        <% categorias.forEach(function (categoria) { %>
                            <option value="<%= categoria %>" <%= filtros.categoria === categoria ? 'selected' : '' %>><%= categoria %></option>
                        <% }); %>
                    </select>
                </div>
            </div>

            <div class="painel-filtros-acoes">
                <button type="submit" class="painel-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Filtrar
                </button>
                <a href="/produtos" class="link-limpar">
                    <i class="fa-solid fa-xmark"></i>
                    Limpar filtros
                </a>
            </div>
        </form>

        <% if (produtos.length === 0) { %>
            <div class="painel-vazio">
                <i class="fa-solid fa-box-open"></i>
                <h3>Nenhum produto encontrado</h3>
                <p>
                    <% if (filtros.q || filtros.categoria) { %>
                        Não encontramos produtos com os filtros informados. Limpe os filtros ou cadastre um novo produto.
                    <% } else { %>
                        Cadastre o primeiro produto para acompanhar o estoque e usá-lo nas vendas e relatórios.
                    <% } %>
                </p>
                <div style="margin-top: 18px;">
                    <a href="/cadastro-produto" class="btn-cadastrar">
                        <i class="fa-solid fa-plus"></i>
                        <span>Cadastrar produto</span>
                    </a>
                </div>
            </div>
        <% } else { %>
            <div class="lista-produtos">
                <% produtos.forEach(function (produto) { %>
                    <article class="produto-card">
                        <div class="produto-visual">
                            <% if (produto.imagem) { %>
                                <img src="<%= produto.imagem %>" alt="Imagem de <%= produto.nome %>" loading="lazy">
                            <% } else { %>
                                <div class="produto-imagem">
                                    <i class="fa-solid fa-seedling"></i>
                                </div>
                            <% } %>
                        </div>

                        <div class="produto-info">
                            <span class="categoria"><%= (produto.categoria || 'OUTROS').toUpperCase() %></span>
                            <h3><%= produto.nome %></h3>
                            <p>
                                <%= formatarMoeda(produto.preco) %> / <%= produto.unidade || 'kg' %>
                                <% if (produto.descricao) { %>
                                    · <%= produto.descricao %>
                                <% } %>
                            </p>
                            <div class="estoque">
                                <i class="fa-solid fa-box"></i>
                                <div>
                                    <span>Disponível</span>
                                    <strong><%= formatarQuantidade(produto.estoque) %> <%= produto.unidade || 'kg' %></strong>
                                </div>
                            </div>
                        </div>

                        <details class="produto-acoes">
                            <summary class="produto-menu-btn" aria-label="Opções de <%= produto.nome %>">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </summary>
                            <div class="produto-acoes-menu">
                                <a href="/cadastro-produto?id=<%= produto.id_produto %>">
                                    <i class="fa-solid fa-pen"></i>
                                    Editar
                                </a>
                                <form action="/produtos/<%= produto.id_produto %>/excluir" method="POST" data-confirmar="Remover o produto &quot;<%= produto.nome %>&quot; do catálogo? As movimentações já registradas serão preservadas.">
                                    <button type="submit">
                                        <i class="fa-solid fa-trash"></i>
                                        Excluir
                                    </button>
                                </form>
                            </div>
                        </details>
                    </article>
                <% }); %>
            </div>
        <% } %>
    </section>
</main>

<%- include('partials/scripts', { scripts: [] }) %>
</body>
</html>
