
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rural Tech - Vendas</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/registrar_vendas.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <%- include('partials/menu') %>

    <header>
        <button class="menu-btn" id="menuBtn">
            <i class="fa-solid fa-bars"></i>
        </button>
        <img src="/img/logotcc.png" alt="Logo Rural Tech">
        <h2>Rural Tech</h2>
    </header>

    <main>
        <div class="topo-vendas">
            <div>
                <h1>Registro de Vendas</h1>
                <h2>Vendas realizadas</h2>
            </div>
        </div>

        <% if (typeof mensagem !== 'undefined' && mensagem) { %>
          <p><%= mensagem %></p>
      <% } %>

        <section class="tabela-vendas">
            <table>
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Produto</th>
                        <th>Quantidade</th>
                        <th>Valor</th>
                        <th>Data</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (vendas.length === 0) { %>
                        <tr>
                            <td colspan="5">Nenhuma venda cadastrada.</td>
                        </tr>
                    <% } else { %>
                        <% vendas.forEach(function(venda) { %>
                            <tr>
                                <td><%= venda.cliente || "Não informado" %></td>
                                <td><%= venda.produto %></td>
                                <td><%= Number(venda.quantidade).toLocaleString("pt-BR") %> <%= venda.unidade %></td>
                                <td><%= Number(venda.valor_total).toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %></td>
                                <td><%= new Date(venda.data_venda).toLocaleDateString("pt-BR", { timeZone: "UTC" }) %></td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>

    <a href="/vendas" class="btn-nova-venda">
        <i class="fa-solid fa-plus"></i> Nova venda
    </a>

    <script src="/js/menu_lateral.js"></script>
</body>
</html>