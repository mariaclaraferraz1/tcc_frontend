<%- include('partials/head', { titulo: titulo, css: [] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<%
    const dadosForm = dados || {};
    const produtoSelecionado = String(dadosForm.idProduto || '');
    const clienteSelecionado = String(dadosForm.idCliente || '');
%>

<main class="painel-main">
    <%- include('partials/mensagens') %>

    <section class="painel-hero">
        <div>
            <span class="eyebrow">
                <i class="fa-solid fa-cart-plus"></i>
                Comercial
            </span>
            <h1>Registrar venda</h1>
            <p>Selecione o produto, informe a quantidade e confirme os dados da venda.</p>
        </div>

        <div class="painel-hero-acoes">
            <a href="/vendas" class="painel-btn-secundario">
                <i class="fa-solid fa-list"></i>
                Ver vendas
            </a>
            <a href="/comercial" class="painel-btn-secundario">
                <i class="fa-solid fa-arrow-left"></i>
                Comercial
            </a>
        </div>
    </section>

    <% if (produtos.length === 0) { %>
        <div class="painel-vazio">
            <i class="fa-solid fa-box-open"></i>
            <h3>Nenhum produto ativo disponível</h3>
            <p>Cadastre um produto com preço e estoque antes de registrar uma venda.</p>
            <div style="margin-top: 18px;">
                <a href="/cadastro-produto" class="painel-btn">
                    <i class="fa-solid fa-plus"></i>
                    Cadastrar produto
                </a>
            </div>
        </div>
    <% } else { %>
        <form action="/vendas" method="POST" class="painel-form" id="form-venda">
            <div class="painel-form-titulo">
                <i class="fa-solid fa-clipboard-list"></i>
                <div>
                    <h2>Dados da venda</h2>
                    <p>O preço unitário e a unidade vêm do cadastro do produto.</p>
                </div>
            </div>

            <div class="painel-dica">
                <i class="fa-solid fa-lightbulb"></i>
                <div>
                    <strong>Estoque e valor calculados pelo sistema</strong>
                    <p>O total é calculado com o preço cadastrado no produto. Ao salvar, o estoque disponível é reduzido automaticamente.</p>
                </div>
            </div>

            <div class="form-grade">
                <div class="form-grupo largo">
                    <label for="idProduto">Produto *</label>
                    <select id="idProduto" name="idProduto" required data-calcular-venda>
                        <option value="">Selecione o produto</option>
                        <% produtos.forEach(function (produto) { %>
                            <option
                                value="<%= produto.id_produto %>"
                                data-preco="<%= Number(produto.preco || 0) %>"
                                data-unidade="<%= produto.unidade || 'kg' %>"
                                data-estoque="<%= Number(produto.estoque || 0) %>"
                                <%= produtoSelecionado === String(produto.id_produto) ? 'selected' : '' %>
                            >
                                <%= produto.nome %> — <%= formatarMoeda(produto.preco) %> / <%= produto.unidade || 'kg' %> (estoque: <%= formatarQuantidade(produto.estoque) %>)
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-grupo">
                    <label for="idCliente">Cliente cadastrado <span class="opcional">(opcional)</span></label>
                    <select id="idCliente" name="idCliente">
                        <option value="">Sem cliente cadastrado</option>
                        <% clientes.forEach(function (cliente) { %>
                            <option value="<%= cliente.id_cliente %>" <%= clienteSelecionado === String(cliente.id_cliente) ? 'selected' : '' %>><%= cliente.nome %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-grupo">
                    <label for="clienteNome">Novo cliente <span class="opcional">(opcional)</span></label>
                    <input type="text" id="clienteNome" name="clienteNome" maxlength="150" value="<%= dadosForm.clienteNome || '' %>" placeholder="Nome do novo cliente">
                    <small>Se preenchido, o cliente será criado ou reutilizado automaticamente.</small>
                </div>

                <div class="form-grupo">
                    <label for="dataVenda">Data da venda *</label>
                    <input type="date" id="dataVenda" name="dataVenda" required value="<%= dadosForm.dataVenda || hoje %>">
                </div>

                <div class="form-grupo">
                    <label for="quantidade">Quantidade vendida *</label>
                    <input type="number" id="quantidade" name="quantidade" min="0.01" step="0.01" required value="<%= dadosForm.quantidade || '' %>" placeholder="Ex: 50" data-calcular-venda>
                </div>

                <div class="form-grupo">
                    <label for="unidade-venda">Unidade</label>
                    <input type="text" id="unidade-venda" readonly class="painel-campo-calculado" value="">
                </div>

                <div class="form-grupo">
                    <label for="preco-venda">Preço unitário (R$)</label>
                    <input type="text" id="preco-venda" readonly class="painel-campo-calculado" value="">
                </div>

                <div class="form-grupo">
                    <label for="valor-total">Valor total</label>
                    <input type="text" id="valor-total" readonly class="painel-campo-calculado" value="R$ 0,00">
                    <small>Calculado automaticamente e validado no servidor.</small>
                </div>

                <div class="form-grupo">
                    <label for="formaPagamento">Forma de pagamento</label>
                    <select id="formaPagamento" name="formaPagamento">
                        <option value="">Selecione</option>
                        <% (formasPagamento || []).forEach(function (forma) { %>
                            <option value="<%= forma %>" <%= dadosForm.formaPagamento === forma ? 'selected' : '' %>><%= forma %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-grupo largo">
                    <label for="observacoes">Observações <span class="opcional">(opcional)</span></label>
                    <textarea id="observacoes" name="observacoes" maxlength="1000" placeholder="Informações adicionais sobre a venda..."><%= dadosForm.observacoes || '' %></textarea>
                </div>
            </div>

            <div class="form-acoes">
                <a href="/vendas" class="painel-btn-secundario">
                    <i class="fa-solid fa-xmark"></i>
                    Cancelar
                </a>
                <button type="submit" class="painel-btn btn-salvar">
                    <i class="fa-solid fa-check"></i>
                    Salvar venda
                </button>
            </div>
        </form>
    <% } %>
</main>

<%- include('partials/scripts', { scripts: ['/js/registrar_vendas.js'] }) %>
</body>
</html>
