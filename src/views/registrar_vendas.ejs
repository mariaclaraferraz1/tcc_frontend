<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rural Tech - Registrar Venda</title>

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/registrar_vendas.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <!-- MENU LATERAL -->
    <%- include('partials/menu') %>

    <!-- CABEÇALHO -->
    <header>
      <button class="menu-btn" id="menuBtn">
        <i class="fa-solid fa-bars"></i>
      </button>

      <img src="/img/logotcc.png" alt="Logo Rural Tech" />

      <h2>Rural Tech</h2>
    </header>

    <!-- CONTEÚDO -->
    <main>
      <div class="topo-vendas">
        <div>
          <h1>Registro de Vendas</h1>

          <h2>Vendas realizadas</h2>
        </div>
      </div>

      <!-- TABELA DE VENDAS -->
      <section class="tabela-vendas">
        <table>
          <thead>
            <tr>
              <th>Cliente</th>

              <th>Produto</th>

              <th>Quantidade</th>

              <th>Valor</th>

              <th>Data</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td>Mariana</td>

              <td>Milho</td>

              <td>10</td>

              <td>R$ 500,00</td>

              <td>31/08/2026</td>
            </tr>

            <tr>
              <td>João</td>

              <td>Soja</td>

              <td>5</td>

              <td>R$ 350,00</td>

              <td>30/08/2026</td>
            </tr>
          </tbody>
        </table>
      </section>
    </main>

    <!-- BOTÃO PARA REGISTRAR NOVA VENDA -->
    <!-- Alterado de vendas.html para a rota /vendas -->
    <a href="/vendas" class="btn-nova-venda">
      <i class="fa-solid fa-plus"></i>

      Nova venda
    </a>

    <script src="/js/menu_lateral.js"></script>
  </body>
</html>
