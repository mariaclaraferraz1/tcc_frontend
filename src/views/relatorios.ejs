<%- include('partials/head', { titulo: titulo, css: [] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<%
    function formatarCelula(valor, formato) {
        if (valor === null || valor === undefined || valor === '') {
            return '-';
        }

        if (formato === 'moeda') {
            return formatarMoeda(valor);
        }

        if (formato === 'data') {
            return formatarData(valor);
        }

        if (formato === 'quantidade') {
            return formatarQuantidade(valor);
        }

        if (formato === 'numero') {
            return formatarNumero(valor, 0);
        }

        if (formato === 'mes') {
            return formatarMes(valor);
        }

        if (formato === 'statusPlantio') {
            return rotuloStatusPlantio(valor);
        }

        return String(valor);
    }
%>

<main class="painel-main">
    <%- include('partials/mensagens') %>

    <section class="painel-hero">
        <div>
            <span class="eyebrow">
                <i class="fa-solid fa-chart-column"></i>
                Análise
            </span>
            <h1>Relatórios</h1>
            <p>Gere relatórios com os dados reais da propriedade, filtrando por tipo, período ou termo de busca.</p>
        </div>

        <div class="painel-hero-acoes">
            <a href="/consulta" class="painel-btn-secundario">
                <i class="fa-solid fa-magnifying-glass"></i>
                Consulta geral
            </a>
        </div>
    </section>

    <form action="/relatorios" method="GET" class="painel-filtros" id="form-relatorio">
        <div class="painel-filtros-titulo">
            <i class="fa-solid fa-filter"></i>
            Configurar relatório
        </div>

        <div class="painel-filtros-grade">
            <div class="form-grupo">
                <label for="tipo">Tipo de relatório *</label>
                <select id="tipo" name="tipo" required>
                    <option value="">Selecione</option>
                    <% tipos.forEach(function (item) { %>
                        <option value="<%= item.valor %>" <%= tipo === item.valor ? 'selected' : '' %>><%= item.rotulo %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-grupo">
                <label for="q">Buscar</label>
                <input type="search" id="q" name="q" value="<%= filtros.q || '' %>" placeholder="Produto, cliente, descrição...">
            </div>

            <div class="form-grupo">
                <label for="inicio">De</label>
                <input type="date" id="inicio" name="inicio" value="<%= filtros.inicio || '' %>">
            </div>

            <div class="form-grupo">
                <label for="fim">Até</label>
                <input type="date" id="fim" name="fim" value="<%= filtros.fim || '' %>">
            </div>
        </div>

        <div class="painel-filtros-acoes">
            <button type="submit" class="painel-btn btn-gerar">
                <i class="fa-solid fa-chart-simple"></i>
                Gerar relatório
            </button>
            <a href="/relatorios" class="link-limpar">
                <i class="fa-solid fa-xmark"></i>
                Limpar filtros
            </a>
        </div>
    </form>

    <% if (!relatorio) { %>
        <div class="painel-vazio">
            <i class="fa-solid fa-file-lines"></i>
            <h3>Selecione um tipo de relatório</h3>
            <p>Escolha vendas, gastos, perdas, produção, produtos ou lucros e clique em "Gerar relatório".</p>
        </div>
    <% } else { %>
        <section class="painel-secao">
            <div class="relatorio-cabecalho">
                <div>
                    <h2><%= relatorio.titulo %></h2>
                    <p>
                        <% if (filtros.inicio || filtros.fim) { %>
                            Período:
                            <%= filtros.inicio ? formatarData(filtros.inicio) : 'início' %>
                            até
                            <%= filtros.fim ? formatarData(filtros.fim) : 'hoje' %>
                        <% } else { %>
                            Todos os registros disponíveis
                        <% } %>
                        <% if (filtros.q) { %>
                            · Busca: "<%= filtros.q %>"
                        <% } %>
                    </p>
                </div>

                <div class="painel-acoes-rapidas">
                    <button type="button" class="painel-btn-secundario" onclick="window.print()">
                        <i class="fa-solid fa-print"></i>
                        Imprimir
                    </button>
                    <button type="button" class="painel-btn-secundario btn-exportar" data-exportar="tabela-relatorio">
                        <i class="fa-solid fa-file-csv"></i>
                        Exportar CSV
                    </button>
                </div>
            </div>

            <% if (relatorio.resumo && relatorio.resumo.length > 0) { %>
                <div class="relatorio-resumo">
                    <% relatorio.resumo.forEach(function (item) { %>
                        <div class="item <%= item.destaque ? 'destaque' : '' %>">
                            <span><%= item.rotulo %></span>
                            <strong><%= formatarCelula(item.valor, item.tipo) %></strong>
                        </div>
                    <% }); %>
                </div>
            <% } %>

            <% if (!relatorio.registros || relatorio.registros.length === 0) { %>
                <div class="painel-vazio">
                    <i class="fa-solid fa-inbox"></i>
                    <h3>Nenhum registro encontrado</h3>
                    <p>Não há dados para os filtros informados. Ajuste o período ou a busca e gere novamente.</p>
                </div>
            <% } else { %>
                <div class="painel-tabela-wrapper">
                    <table class="painel-tabela" id="tabela-relatorio" data-titulo="<%= relatorio.titulo %>">
                        <thead>
                            <tr>
                                <% relatorio.colunas.forEach(function (coluna) { %>
                                    <th><%= coluna.rotulo %></th>
                                <% }); %>
                            </tr>
                        </thead>
                        <tbody>
                            <% relatorio.registros.forEach(function (registro) { %>
                                <tr>
                                    <% relatorio.colunas.forEach(function (coluna) { %>
                                        <td><%= formatarCelula(registro[coluna.chave], coluna.tipo) %></td>
                                    <% }); %>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <p class="form-ajuda" style="margin-top: 10px;">
                    <%= relatorio.registros.length %> registro(s) exibido(s).
                </p>
            <% } %>
        </section>
    <% } %>
</main>

<%- include('partials/scripts', { scripts: ['/js/relatorios.js'] }) %>
</body>
</html>
