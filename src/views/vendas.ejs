<%- include('partials/head', { titulo: titulo, css: [] }) %>
<%- include('partials/menu') %>
<%- include('partials/header') %>

<main class="painel-main">
    <%- include('partials/mensagens') %>

    <section class="painel-hero">
        <div>
            <span class="eyebrow">
                <i class="fa-solid fa-cart-shopping"></i>
                Comercial
            </span>
            <h1>Vendas</h1>
            <p>Acompanhe as vendas registradas, o faturamento e o ticket médio do período.</p>
        </div>

        <div class="painel-hero-acoes">
            <a href="/registrar-vendas" class="painel-btn">
                <i class="fa-solid fa-plus"></i>
                Nova venda
            </a>
            <a href="/comercial" class="painel-btn-secundario">
                <i class="fa-solid fa-arrow-left"></i>
                Comercial
            </a>
        </div>
    </section>

    <section class="painel-resumo">
        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-money-bill-wave"></i></div>
            <div class="painel-card-info">
                <span>Total vendido</span>
                <strong><%= formatarMoeda(resumo.total_valor || 0) %></strong>
                <small>Nos filtros atuais</small>
            </div>
        </div>

        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-receipt"></i></div>
            <div class="painel-card-info">
                <span>Registros</span>
                <strong><%= formatarNumero(resumo.total_registros || 0, 0) %></strong>
                <small>Vendas realizadas</small>
            </div>
        </div>

        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-weight-hanging"></i></div>
            <div class="painel-card-info">
                <span>Quantidade vendida</span>
                <strong><%= formatarQuantidade(resumo.total_quantidade || 0) %></strong>
                <small>Somatório das unidades</small>
            </div>
        </div>

        <div class="painel-card">
            <div class="painel-card-icone"><i class="fa-solid fa-chart-line"></i></div>
            <div class="painel-card-info">
                <span>Ticket médio</span>
                <strong><%= formatarMoeda(resumo.ticket_medio || 0) %></strong>
                <small>Valor médio por venda</small>
            </div>
        </div>
    </section>

    <form action="/vendas" method="GET" class="painel-filtros">
        <div class="painel-filtros-titulo">
            <i class="fa-solid fa-filter"></i>
            Filtrar vendas
        </div>

        <div class="painel-filtros-grade">
            <div class="form-grupo">
                <label for="filtro-q">Buscar</label>
                <input type="search" id="filtro-q" name="q" value="<%= filtros.q || '' %>" placeholder="Produto, cliente, pagamento...">
            </div>

            <div class="form-grupo">
                <label for="filtro-produto">Produto</label>
                <select id="filtro-produto" name="idProduto">
                    <option value="">Todos os produtos</option>
                    <% produtos.forEach(function (produto) { %>
                        <option value="<%= produto.id_produto %>" <%= String(filtros.idProduto || '') === String(produto.id_produto) ? 'selected' : '' %>><%= produto.nome %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-grupo">
                <label for="filtro-cliente">Cliente</label>
                <select id="filtro-cliente" name="idCliente">
                    <option value="">Todos os clientes</option>
                    <% clientes.forEach(function (cliente) { %>
                        <option value="<%= cliente.id_cliente %>" <%= String(filtros.idCliente || '') === String(cliente.id_cliente) ? 'selected' : '' %>><%= cliente.nome %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-grupo">
                <label for="filtro-pagamento">Forma de pagamento</label>
                <select id="filtro-pagamento" name="formaPagamento">
                    <option value="">Todas</option>
                    <% formasPagamento.forEach(function (forma) { %>
                        <option value="<%= forma.forma_pagamento %>" <%= filtros.formaPagamento === forma.forma_pagamento ? 'selected' : '' %>><%= forma.forma_pagamento %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-grupo">
                <label for="filtro-inicio">De</label>
                <input type="date" id="filtro-inicio" name="inicio" value="<%= filtros.inicio || '' %>">
            </div>

            <div class="form-grupo">
                <label for="filtro-fim">Até</label>
                <input type="date" id="filtro-fim" name="fim" value="<%= filtros.fim || '' %>">
            </div>
        </div>

        <div class="painel-filtros-acoes">
            <button type="submit" class="painel-btn">
                <i class="fa-solid fa-magnifying-glass"></i>
                Filtrar
            </button>
            <a href="/vendas" class="link-limpar">
                <i class="fa-solid fa-xmark"></i>
                Limpar filtros
            </a>
        </div>
    </form>

    <% if (vendas.length === 0) { %>
        <div class="painel-vazio">
            <i class="fa-solid fa-cart-shopping"></i>
            <h3>Nenhuma venda encontrada</h3>
            <p>
                <% if (filtros.q || filtros.inicio || filtros.fim || filtros.idProduto || filtros.idCliente || filtros.formaPagamento) { %>
                    Não há vendas para os filtros informados. Ajuste os critérios ou limpe os filtros.
                <% } else { %>
                    Registre a primeira venda para acompanhar o faturamento e o lucro da propriedade.
                <% } %>
            </p>
            <div style="margin-top: 18px;">
                <a href="/registrar-vendas" class="painel-btn">
                    <i class="fa-solid fa-plus"></i>
                    Registrar venda
                </a>
            </div>
        </div>
    <% } else { %>
        <div class="painel-tabela-wrapper">
            <table class="painel-tabela">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Produto</th>
                        <th>Cliente</th>
                        <th>Qtd.</th>
                        <th>Preço unit.</th>
                        <th>Total</th>
                        <th>Pagamento</th>
                        <th>Observações</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% vendas.forEach(function (venda) { %>
                        <tr>
                            <td><%= formatarData(venda.data_venda) %></td>
                            <td><%= venda.produto %></td>
                            <td><%= venda.cliente || '-' %></td>
                            <td class="numero"><%= formatarQuantidade(venda.quantidade) %> <%= venda.unidade || venda.produto_unidade || '' %></td>
                            <td class="numero"><%= formatarMoeda(venda.preco_unitario) %></td>
                            <td class="numero"><strong><%= formatarMoeda(venda.valor_total) %></strong></td>
                            <td><%= venda.forma_pagamento || '-' %></td>
                            <td class="observacao"><%= venda.observacoes || '-' %></td>
                            <td>
                                <div class="acoes">
                                    <form action="/vendas/<%= venda.id_venda %>/excluir" method="POST" data-confirmar="Excluir esta venda? O estoque do produto será devolvido.">
                                        <button type="submit" class="painel-btn-perigo painel-btn-mini">
                                            <i class="fa-solid fa-trash"></i>
                                            Excluir
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</main>

<%- include('partials/scripts', { scripts: [] }) %>
</body>
</html>
