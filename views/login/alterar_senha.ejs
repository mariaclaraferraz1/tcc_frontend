<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rural Tech - Alterar Senha</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/alterar_senha.css">

</head>

<body>

    <!-- MENU LATERAL -->

    <nav class="menu-lateral">

        <div class="menu-topo">

            <img src="/img/logotcc.png" alt="Logo Rural Tech">

            <span>Rural Tech</span>

        </div>

        <ul>

            <li>
                <a href="/inicio">
                    <i class="fa-solid fa-house"></i>
                    <span>Início</span>
                </a>
            </li>

            <li>
                <a href="/produtos">
                    <i class="fa-solid fa-box"></i>
                    <span>Produtos</span>
                </a>
            </li>

            <li>
                <a href="/producao">
                    <i class="fa-solid fa-seedling"></i>
                    <span>Produção</span>
                </a>
            </li>

            <li>
                <a href="/comercial">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Comercial</span>
                </a>
            </li>

            <li>
                <a href="/relatorios">
                    <i class="fa-solid fa-chart-column"></i>
                    <span>Relatórios</span>
                </a>
            </li>

            <li>
                <a href="/consulta">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Consulta</span>
                </a>
            </li>

            <li>
                <a href="/configuracoes" class="ativo">
                    <i class="fa-solid fa-gear"></i>
                    <span>Configurações</span>
                </a>
            </li>

        </ul>

    </nav>

    <div class="fundo-menu"></div>

    <!-- CABEÇALHO -->

    <header>

        <button class="menu-btn" id="menuBtn">

            <i class="fa-solid fa-bars"></i>

        </button>

        <img src="/img/logotcc.png" alt="Logo Rural Tech">

        <h2>Rural Tech</h2>

    </header>

    <!-- CONTEÚDO -->

    <main>

        <section class="cabecalho-pagina">

            <span class="subtitulo">CONFIGURAÇÕES</span>

            <h1>Alterar senha</h1>

            <p>
                Atualize a senha para manter sua conta protegida.
            </p>

        </section>

        <section class="senha-card">

            <div class="titulo-card">

                <div class="icone-senha">
                    <i class="fa-solid fa-lock"></i>
                </div>

                <div>

                    <h2>Segurança da conta</h2>

                    <p>
                        Informe sua senha atual e escolha uma nova senha.
                    </p>

                </div>

            </div>

            <form id="formSenha">

                <div class="campo">

                    <label for="senhaAtual">
                        Senha atual
                    </label>

                    <input
                        type="password"
                        id="senhaAtual"
                        placeholder="Digite sua senha atual"
                        required
                    >

                </div>

                <div class="campo">

                    <label for="novaSenha">
                        Nova senha
                    </label>

                    <input
                        type="password"
                        id="novaSenha"
                        placeholder="Digite sua nova senha"
                        required
                    >

                </div>

                <div class="campo">

                    <label for="confirmarSenha">
                        Confirmar nova senha
                    </label>

                    <input
                        type="password"
                        id="confirmarSenha"
                        placeholder="Digite novamente a nova senha"
                        required
                    >

                </div>

                <div class="botoes">

                    <a href="/configuracoes" class="btn-cancelar">
                        Cancelar
                    </a>

                    <button type="submit" class="btn-salvar">

                        <i class="fa-solid fa-check"></i>

                        Alterar senha

                    </button>

                </div>

            </form>

        </section>

    </main>

    <script src="/js/menu_lateral.js"></script>
    <script src="/js/alterar_senha.js"></script>

</body>

</html>